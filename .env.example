# Copy this file to .env for local development (npm run dev / npm run build).
# In GitHub Actions, these are set as repository *variables* (not secrets — see
# README.md), since Supabase's publishable key is designed to be public.

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
