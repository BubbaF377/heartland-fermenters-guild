---
import Layout from '../../layouts/Layout.astro';
import { MAX_PHOTO_MB, PHOTO_TYPES, PHOTO_TYPE_NAMES, RECIPE_CATEGORIES } from '../../lib/constants.js';
---

<Layout
  title="Submit a Recipe — Heartland Fermenters Guild"
  description="Guild members: submit a recipe for review."
>
  <main class="submit-page">
    <h1>Submit a Recipe</h1>
    <p class="intro">
      For active guild members. A submitted recipe doesn&rsquo;t appear on the site right
      away — an admin reviews it first.
    </p>

    <section id="login-section">
      <p>Enter your email and we&rsquo;ll send you a one-time login link.</p>
      <form id="login-form">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
        <button type="submit">Email me a login link</button>
      </form>
      <p id="login-status" class="status" hidden></p>
    </section>

    <section id="submit-section" hidden>
      <div class="admin-bar">
        <p id="logged-in-as"></p>
        <button id="logout-button" type="button" class="secondary">Log out</button>
      </div>

      <form id="recipe-form">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required />

        <label for="category">Category</label>
        <select id="category" name="category" required>
          {RECIPE_CATEGORIES.map((category) => <option value={category}>{category}</option>)}
        </select>

        <label for="summary">Short summary</label>
        <textarea id="summary" name="summary" rows="2"></textarea>

        <label for="photo">Photo <span class="hint">(optional)</span></label>
        <input
          type="file"
          id="photo"
          name="photo"
          accept={Object.keys(PHOTO_TYPES).join(',')}
          aria-describedby="photo-requirements"
        />
        <p id="photo-requirements" class="field-note">
          {PHOTO_TYPE_NAMES}, up to {MAX_PHOTO_MB} MB. Landscape photos work best, at least 1200&nbsp;px
          wide. The recipe page crops photos to a wide frame, so keep the dish near the center.
        </p>
        <p id="photo-error" class="field-error" role="alert" hidden></p>

        <label for="video_url">How-to video <span class="hint">(optional — a YouTube link)</span></label>
        <input type="url" id="video_url" name="video_url" placeholder="https://www.youtube.com/watch?v=..." />

        <label for="yield_text">Yield / servings <span class="hint">(optional)</span></label>
        <input type="text" id="yield_text" name="yield_text" placeholder="e.g. About 1 quart" />

        <label id="time-stages-label">Time stages <span class="hint">(optional — e.g. Prep, Ferment, Bake)</span></label>
        <div id="time-stages-list" aria-labelledby="time-stages-label"></div>
        <button type="button" id="add-stage-button" class="secondary stage-add">+ Add stage</button>

        <label for="ingredients">Ingredients <span class="hint">(one per line)</span></label>
        <textarea id="ingredients" name="ingredients" rows="6" required></textarea>

        <label for="instructions">Instructions <span class="hint">(one step per line)</span></label>
        <textarea id="instructions" name="instructions" rows="8" required></textarea>

        <label for="notes">Notes &amp; tips <span class="hint">(optional)</span></label>
        <textarea id="notes" name="notes" rows="3"></textarea>

        <label for="submitted_by">Your name <span class="hint">(optional — shown publicly once approved)</span></label>
        <input type="text" id="submitted_by" name="submitted_by" />

        <div class="form-actions">
          <button type="submit" id="save-button">Submit Recipe</button>
          <button type="button" id="preview-button" class="secondary">Preview</button>
        </div>
      </form>
      <p id="recipe-status" class="status" hidden></p>
    </section>
  </main>

  <script>
    import {
      isSignInWithEmailLink,
      onAuthStateChanged,
      sendSignInLinkToEmail,
      signInWithEmailLink,
      signOut,
    } from 'firebase/auth';
    import { auth, createRecipeWithUniqueSlug, uploadRecipePhoto } from '../../lib/firebase.js';
    import { slugify } from '../../lib/constants.js';
    import { wireStageEditor, wirePhotoInput, collectRecipeFields, openRecipePreview } from '../../lib/recipe-form.js';

    const loginSection = document.getElementById('login-section');
    const submitSection = document.getElementById('submit-section');
    const loginForm = document.getElementById('login-form');
    const loginStatus = document.getElementById('login-status');
    const loginButton = loginForm.querySelector('button[type="submit"]');
    const loggedInAs = document.getElementById('logged-in-as');
    const logoutButton = document.getElementById('logout-button');
    const recipeForm = document.getElementById('recipe-form');
    const recipeStatus = document.getElementById('recipe-status');
    const categorySelect = document.getElementById('category');
    const stagesList = document.getElementById('time-stages-list');
    const addStageButton = document.getElementById('add-stage-button');
    const photoInput = document.getElementById('photo');
    const photoError = document.getElementById('photo-error');
    const previewButton = document.getElementById('preview-button');
    const saveButton = document.getElementById('save-button');

    // Firebase's email-link sign-in needs the email again when the link is opened,
    // to prove the person clicking it is the one it was sent to. Remembered here
    // when the link is requested; if the link is opened in a different browser,
    // the member is asked to type it again instead.
    const EMAIL_STORAGE_KEY = 'hfg-member-login-email';

    const { reset: resetStageSuggestions } = wireStageEditor({ stagesList, addStageButton, categorySelect });
    wirePhotoInput(photoInput, photoError);

    previewButton.addEventListener('click', () => {
      if (!openRecipePreview({ form: recipeForm, stagesList, photoInput })) {
        showStatus(recipeStatus, true, "Preview isn't available in this browser (it may be blocking site storage).");
      }
    });

    function showStatus(el, isError, message) {
      el.className = isError ? 'status error' : 'status success';
      el.textContent = message;
      el.hidden = false;
    }

    function showLoggedIn(isLoggedIn, email) {
      loginSection.hidden = isLoggedIn;
      submitSection.hidden = !isLoggedIn;
      if (isLoggedIn) loggedInAs.textContent = `Logged in as ${email}.`;
    }

    // Reflect whatever the current session actually is (a returning member stays
    // logged in via Firebase's persisted session).
    onAuthStateChanged(auth, (user) => {
      showLoggedIn(Boolean(user), user?.email);
    });

    // Set when this page was opened from an emailed login link (it carries the
    // one-time code in its query string). Cleared once the link has been used.
    let pendingLoginLink = isSignInWithEmailLink(auth, window.location.href) ? window.location.href : null;

    async function completeLinkSignIn(email) {
      try {
        await signInWithEmailLink(auth, email, pendingLoginLink);
        try {
          window.localStorage.removeItem(EMAIL_STORAGE_KEY);
        } catch {}
        pendingLoginLink = null;
        loginButton.textContent = 'Email me a login link';
        // Drop the one-time code from the address bar so a refresh or a copied
        // URL doesn't try to reuse an already-spent link.
        window.history.replaceState(null, '', window.location.pathname);
      } catch {
        showStatus(
          loginStatus,
          true,
          "That login link didn't work — it may have expired, already been used, or been sent to a different email. Request a new one below.",
        );
      }
    }

    if (pendingLoginLink) {
      let savedEmail = null;
      try {
        savedEmail = window.localStorage.getItem(EMAIL_STORAGE_KEY);
      } catch {}

      if (savedEmail) {
        await completeLinkSignIn(savedEmail);
      } else {
        loginButton.textContent = 'Log in';
        showStatus(loginStatus, false, 'Confirm the email address this login link was sent to.');
      }
    }

    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      loginStatus.hidden = true;

      const email = String(new FormData(loginForm).get('email') || '').trim();
      loginButton.disabled = true;

      if (pendingLoginLink) {
        await completeLinkSignIn(email);
        loginButton.disabled = false;
        return;
      }

      // Authentication itself is open to any email — that's how email-link login
      // works. Whether this email is actually an active member is checked by
      // firestore.rules when they try to submit, not here.
      try {
        await sendSignInLinkToEmail(auth, email, {
          url: `${window.location.origin}/submit/`,
          handleCodeInApp: true,
        });
        try {
          window.localStorage.setItem(EMAIL_STORAGE_KEY, email);
        } catch {}
        showStatus(loginStatus, false, `Check ${email} for a login link.`);
      } catch {
        showStatus(loginStatus, true, 'Could not send a login link — please try again.');
      } finally {
        loginButton.disabled = false;
      }
    });

    logoutButton.addEventListener('click', async () => {
      await signOut(auth);
    });

    recipeForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      recipeStatus.hidden = true;

      const fields = collectRecipeFields(recipeForm, stagesList);
      const photoFile = photoInput.files[0] || null;

      saveButton.disabled = true;

      try {
        const baseSlug = slugify(fields.title) || 'recipe';
        const photoPath = photoFile ? await uploadRecipePhoto(photoFile, baseSlug) : null;

        // Slug collisions with pending/deactivated recipes are detected too, even
        // though a member can't read those — see createRecipeWithUniqueSlug.
        await createRecipeWithUniqueSlug(baseSlug, { ...fields, photo_path: photoPath, status: 'pending' });

        showStatus(recipeStatus, false, 'Thanks! Your recipe was submitted and is now waiting for admin review.');
        recipeForm.reset();
        resetStageSuggestions();
      } catch (err) {
        // The most likely cause of a denied write (Firestore create, or the photo
        // upload before it) is that this email isn't, or is no longer, an active
        // member — see firestore.rules / storage.rules.
        const denied = err?.code === 'permission-denied' || err?.code === 'storage/unauthorized';
        showStatus(
          recipeStatus,
          true,
          denied
            ? "Could not submit — this email isn't on the active member list. Contact makers@heartlandfermentersguild.org to be added."
            : 'Could not submit your recipe right now — please try again in a moment.',
        );
      } finally {
        saveButton.disabled = false;
      }
    });
  </script>
</Layout>

<!--
  is:global: the time-stage rows are built client-side with document.createElement.
  Astro's scoped styles only match elements it renders itself, so a scoped style
  here would silently fail to apply to them.
-->
<style is:global>
  .submit-page {
    max-width: 620px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .submit-page h1 {
    font-size: clamp(2rem, 4.5vw, 2.6rem);
    margin-bottom: 0.75rem;
  }

  .submit-page .intro {
    color: var(--brown);
    margin: 0 0 1.5rem;
  }

  .submit-page form {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .submit-page label {
    font-weight: 600;
    color: var(--brown-deep);
    margin-top: 0.75rem;
  }

  .submit-page .hint {
    font-weight: 400;
    color: var(--brown);
    opacity: 0.8;
  }

  .submit-page input,
  .submit-page select,
  .submit-page textarea {
    font: inherit;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(44, 30, 18, 0.3);
    border-radius: 6px;
    background: var(--cream-light);
    color: var(--ink);
  }

  .submit-page input:focus,
  .submit-page select:focus,
  .submit-page textarea:focus {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  .submit-page textarea {
    resize: vertical;
    font-family: inherit;
  }

  .submit-page button {
    font: inherit;
    font-weight: 600;
    margin-top: 1.25rem;
    padding: 0.65rem 1.2rem;
    border: none;
    border-radius: 8px;
    background: var(--green-deep);
    color: var(--cream-light);
    cursor: pointer;
    align-self: flex-start;
  }

  .submit-page button:hover,
  .submit-page button:focus-visible {
    background: var(--green);
  }

  .submit-page button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* 0.55 so the outline reaches 3:1 against the page; 0.3 measured 1.9:1. */
  .submit-page button.secondary {
    background: transparent;
    color: var(--brown-deep);
    border: 1px solid rgba(44, 30, 18, 0.55);
    margin-top: 0;
  }

  .submit-page .admin-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(44, 30, 18, 0.15);
  }

  .submit-page .admin-bar p {
    margin: 0;
    color: var(--brown);
  }

  .submit-page #time-stages-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }

  .submit-page .stage-row {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 0.5rem;
    align-items: center;
  }

  .submit-page .stage-remove {
    padding: 0.4rem 0.7rem;
    line-height: 1;
    font-size: 1.1rem;
  }

  .submit-page .stage-add {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .submit-page .field-note {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--brown);
  }

  .submit-page .field-error {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--wine);
  }

  .submit-page .form-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .submit-page .form-actions button {
    margin-top: 0;
  }

  .submit-page .status {
    margin-top: 1rem;
  }

  .submit-page .status.success {
    color: var(--green-deep);
    font-weight: 600;
  }

  .submit-page .status.error {
    color: var(--wine);
    font-weight: 600;
  }
</style>
