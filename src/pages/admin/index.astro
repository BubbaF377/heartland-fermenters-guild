---
import Layout from '../../layouts/Layout.astro';
import { MAX_PHOTO_MB, PHOTO_TYPES, PHOTO_TYPE_NAMES, RECIPE_CATEGORIES } from '../../lib/constants.js';
---

<Layout
  title="Admin — Heartland Fermenters Guild"
  description="Guild admin: manage recipes and members."
>
  <main class="admin-page">
    <h1>Admin</h1>

    <section id="login-section">
      <p>Enter the guild admin password to add a recipe.</p>
      <form id="login-form">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" />
        <button type="submit">Log in</button>
      </form>
      <p id="login-error" class="error" hidden></p>
    </section>

    <section id="admin-section" hidden>
      <div class="admin-bar">
        <p>Logged in.</p>
        <button id="logout-button" type="button" class="secondary">Log out</button>
      </div>

      <div class="admin-tabs" role="tablist" aria-label="Admin sections">
        <button type="button" role="tab" id="tab-recipes" aria-controls="panel-recipes" aria-selected="true">
          Recipes
        </button>
        <button type="button" role="tab" id="tab-members" aria-controls="panel-members" aria-selected="false" tabindex="-1">
          Members
        </button>
      </div>

      <div id="panel-recipes" role="tabpanel" aria-labelledby="tab-recipes">
        <div id="recipe-subtabs" class="admin-subtabs" role="tablist" aria-label="Recipes">
          <button type="button" role="tab" id="subtab-stored" aria-controls="subpanel-stored" aria-selected="true">
            Stored Recipes
          </button>
          <button type="button" role="tab" id="subtab-pending" aria-controls="subpanel-pending" aria-selected="false" tabindex="-1">
            Pending Recipes<span id="pending-count" class="tab-count" hidden></span>
          </button>
          <button type="button" role="tab" id="subtab-form" aria-controls="subpanel-form" aria-selected="false" tabindex="-1">
            Add a Recipe
          </button>
        </div>

        <div id="subpanel-stored" role="tabpanel" aria-labelledby="subtab-stored">
          <p id="recipe-list-status" class="status">Loading recipes&hellip;</p>
          <ul id="recipe-list" class="recipe-list" hidden></ul>
        </div>

        <div id="subpanel-pending" role="tabpanel" aria-labelledby="subtab-pending" hidden>
          <p id="pending-list-status" class="status">Loading&hellip;</p>
          <ul id="pending-list" class="recipe-list" hidden></ul>
        </div>

        <div id="subpanel-form" role="tabpanel" aria-labelledby="subtab-form" hidden>
          <h2 id="recipe-form-heading">Add a Recipe</h2>
          <form id="recipe-form">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required />

            <label for="category">Category</label>
            <select id="category" name="category" required>
              {RECIPE_CATEGORIES.map((category) => <option value={category}>{category}</option>)}
            </select>

            <label for="summary">Short summary</label>
            <textarea id="summary" name="summary" rows="2"></textarea>

            <label for="photo">Photo <span class="hint">(optional)</span></label>
            <input
              type="file"
              id="photo"
              name="photo"
              accept={Object.keys(PHOTO_TYPES).join(',')}
              aria-describedby="photo-requirements"
            />
            <p id="photo-requirements" class="field-note">
              {PHOTO_TYPE_NAMES}, up to {MAX_PHOTO_MB} MB. Landscape photos work best, at least 1200&nbsp;px
              wide. The recipe page crops photos to a wide frame, so keep the dish near the center.
            </p>
            <p id="photo-error" class="field-error" role="alert" hidden></p>

            <label for="video_url">How-to video <span class="hint">(optional — a YouTube link)</span></label>
            <input type="url" id="video_url" name="video_url" placeholder="https://www.youtube.com/watch?v=..." />

            <label for="yield_text">Yield / servings <span class="hint">(optional)</span></label>
            <input type="text" id="yield_text" name="yield_text" placeholder="e.g. About 1 quart" />

            <label id="time-stages-label">Time stages <span class="hint">(optional — e.g. Prep, Ferment, Bake)</span></label>
            <div id="time-stages-list" aria-labelledby="time-stages-label"></div>
            <button type="button" id="add-stage-button" class="secondary stage-add">+ Add stage</button>

            <label for="ingredients">Ingredients <span class="hint">(one per line)</span></label>
            <textarea id="ingredients" name="ingredients" rows="6" required></textarea>

            <label for="instructions">Instructions <span class="hint">(one step per line)</span></label>
            <textarea id="instructions" name="instructions" rows="8" required></textarea>

            <label for="notes">Notes &amp; tips <span class="hint">(optional)</span></label>
            <textarea id="notes" name="notes" rows="3"></textarea>

            <label for="submitted_by">Your name <span class="hint">(optional)</span></label>
            <input type="text" id="submitted_by" name="submitted_by" />

            <div class="form-actions">
              <button type="submit" id="save-button">Save Recipe</button>
              <button type="button" id="preview-button" class="secondary">Preview</button>
              <button type="button" id="cancel-edit-button" class="secondary" hidden>Cancel</button>
            </div>
          </form>
          <p id="recipe-status" class="status" hidden></p>
        </div>
      </div>

      <div id="panel-members" role="tabpanel" aria-labelledby="tab-members" hidden>
        <div id="member-subtabs" class="admin-subtabs" role="tablist" aria-label="Members">
          <button type="button" role="tab" id="subtab-member-list" aria-controls="subpanel-member-list" aria-selected="true">
            Member List
          </button>
          <button type="button" role="tab" id="subtab-member-form" aria-controls="subpanel-member-form" aria-selected="false" tabindex="-1">
            Add a Member
          </button>
        </div>

        <div id="subpanel-member-list" role="tabpanel" aria-labelledby="subtab-member-list">
          <p id="members-status" class="status">Loading members&hellip;</p>
          <ul id="members-list" class="recipe-list" hidden></ul>
        </div>

        <div id="subpanel-member-form" role="tabpanel" aria-labelledby="subtab-member-form" hidden>
          <form id="add-member-form">
            <h2 id="member-form-heading">Add a Member</h2>
            <label for="member-name">Member name</label>
            <input type="text" id="member-name" name="name" required autocomplete="off" />

            <label for="member-email">Member email <span class="hint">(optional — needed to log in and submit recipes)</span></label>
            <input type="email" id="member-email" name="email" autocomplete="off" placeholder="member@example.com" />

            <label for="member-phone">Member phone <span class="hint">(optional)</span></label>
            <input type="tel" id="member-phone" name="phone" autocomplete="off" placeholder="(402) 555-0134" />

            <div class="form-actions">
              <button type="submit" id="member-save-button">Add Member</button>
              <button type="button" id="member-cancel-button" class="secondary" hidden>Cancel</button>
            </div>
          </form>
          <p id="add-member-status" class="status" hidden></p>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { onAuthStateChanged, signInWithEmailAndPassword, signOut } from 'firebase/auth';
    import {
      collection,
      deleteDoc,
      doc,
      getDoc,
      getDocsFromServer,
      orderBy,
      query,
      runTransaction,
      serverTimestamp,
      setDoc,
      updateDoc,
    } from 'firebase/firestore';
    import { deleteObject, ref } from 'firebase/storage';
    import {
      auth,
      createRecipeWithUniqueSlug,
      db,
      recipeFromSnap,
      setPhotoSrc,
      storage,
      uploadRecipePhoto,
    } from '../../lib/firebase.js';
    import { ADMIN_EMAIL, RECIPE_PHOTOS_PATH, formatPhone, phoneDigits, slugify } from '../../lib/constants.js';
    import {
      wireStageEditor,
      wirePhotoInput,
      collectRecipeFields,
      populateRecipeForm,
      openRecipePreview,
    } from '../../lib/recipe-form.js';

    const loginSection = document.getElementById('login-section');
    const adminSection = document.getElementById('admin-section');
    const loginForm = document.getElementById('login-form');
    const loginError = document.getElementById('login-error');
    const logoutButton = document.getElementById('logout-button');
    const recipeForm = document.getElementById('recipe-form');
    const recipeStatus = document.getElementById('recipe-status');
    const categorySelect = document.getElementById('category');
    const stagesList = document.getElementById('time-stages-list');
    const addStageButton = document.getElementById('add-stage-button');
    const photoInput = document.getElementById('photo');
    const photoError = document.getElementById('photo-error');
    const previewButton = document.getElementById('preview-button');
    const pendingListStatus = document.getElementById('pending-list-status');
    const pendingList = document.getElementById('pending-list');
    const pendingCount = document.getElementById('pending-count');
    const recipeListStatus = document.getElementById('recipe-list-status');
    const recipeList = document.getElementById('recipe-list');
    const membersStatus = document.getElementById('members-status');
    const membersList = document.getElementById('members-list');
    const addMemberForm = document.getElementById('add-member-form');
    const addMemberStatus = document.getElementById('add-member-status');
    const memberFormHeading = document.getElementById('member-form-heading');
    const memberSaveButton = document.getElementById('member-save-button');
    const memberCancelButton = document.getElementById('member-cancel-button');
    const formHeading = document.getElementById('recipe-form-heading');
    const saveButton = document.getElementById('save-button');
    const cancelEditButton = document.getElementById('cancel-edit-button');

    // null in create mode; while editing, these hold the recipe's slug (its
    // document ID, which never changes on edit — see startEditing), its current
    // photo_path (resubmitted unchanged unless a new file is chosen), and its
    // created_at (so Preview shows the recipe's real date, not today's).
    let editingSlug = null;
    let editingPhotoPath = null;
    let editingCreatedAt = null;

    const { markTouched: markStagesTouched, reset: resetStageSuggestions } = wireStageEditor({
      stagesList,
      addStageButton,
      categorySelect,
    });

    // --- Tabs: Recipes (Stored / Pending / Add a Recipe), Members (List / Add) ---

    // Standard ARIA tab groups: the top-level strip, and each top-level tab's
    // own sub-tabs. In each group only the selected tab is in the Tab order,
    // and the arrow keys (plus Home/End) move between tabs and select as they
    // go. The view is remembered in the URL, so a reload or a bookmark lands
    // back on it: no hash is Recipes → Stored Recipes.
    const VIEW_HASHES = {
      'subtab-pending': '#pending',
      'subtab-form': '#add-recipe',
      'subtab-member-list': '#members',
      'subtab-member-form': '#add-member',
    };

    function wireTabGroup(tablist) {
      const tabs = [...tablist.querySelectorAll('[role="tab"]')];
      const group = {
        tabs,
        selected: tabs[0],
        select(tab, { focus = false } = {}) {
          for (const each of tabs) {
            const isSelected = each === tab;
            each.setAttribute('aria-selected', String(isSelected));
            each.tabIndex = isSelected ? 0 : -1;
            document.getElementById(each.getAttribute('aria-controls')).hidden = !isSelected;
          }
          group.selected = tab;
          if (focus) tab.focus();
          rememberView();
        },
      };
      for (const tab of tabs) {
        tab.addEventListener('click', () => group.select(tab));
        tab.addEventListener('keydown', (event) => {
          const index = tabs.indexOf(tab);
          const next = {
            ArrowRight: tabs[(index + 1) % tabs.length],
            ArrowLeft: tabs[(index - 1 + tabs.length) % tabs.length],
            Home: tabs[0],
            End: tabs[tabs.length - 1],
          }[event.key];
          if (!next) return;
          event.preventDefault();
          group.select(next, { focus: true });
        });
      }
      return group;
    }

    const topTabs = wireTabGroup(document.querySelector('.admin-tabs'));
    // Each top-level tab's sub-tabs, keyed by the top-level tab's id.
    const subTabs = {
      'tab-recipes': wireTabGroup(document.getElementById('recipe-subtabs')),
      'tab-members': wireTabGroup(document.getElementById('member-subtabs')),
    };
    const recipeFormTab = document.getElementById('subtab-form');
    const memberFormTab = document.getElementById('subtab-member-form');

    // Only runs from a tab selection, which happens after every group exists.
    function rememberView() {
      const view = subTabs[topTabs.selected.id].selected;
      const hash = VIEW_HASHES[view.id] || '';
      if (window.location.hash !== hash) {
        window.history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`);
      }
    }

    // Opens a sub-tab's view, selecting the top-level tab around it too.
    function showView(subTabId) {
      const tab = document.getElementById(subTabId);
      const [topId, group] = Object.entries(subTabs).find(([, g]) => g.tabs.includes(tab));
      topTabs.select(document.getElementById(topId));
      group.select(tab);
    }

    const viewFromHash = Object.keys(VIEW_HASHES).find((id) => VIEW_HASHES[id] === window.location.hash);
    showView(viewFromHash || 'subtab-stored');

    // --- Recipe + pending-recipe lists (Requirements #14, #16) ---

    // An auth-state change (login, logout, a token refresh swapping sessions) can
    // land while a previous load is still in flight — so this can be called
    // several times in close succession. Each call clears the lists before
    // its await, so without a guard, overlapping calls each clear then later append
    // their own copy, rendering the same rows multiple times. This id makes only
    // the most recently started call allowed to render; a call superseded by a
    // newer one discards its results instead of appending stale duplicates.
    let recipeListRequestId = 0;

    // One fetch (firestore.rules lets admin list every status) split
    // client-side into the pending queue and the published/deactivated list,
    // rather than two round-trips.
    async function loadRecipeList() {
      const requestId = ++recipeListRequestId;

      pendingListStatus.hidden = false;
      pendingListStatus.textContent = 'Loading…';
      pendingList.hidden = true;
      pendingList.innerHTML = '';

      recipeListStatus.hidden = false;
      recipeListStatus.textContent = 'Loading recipes…';
      recipeList.hidden = true;
      recipeList.innerHTML = '';

      let data;
      try {
        const snapshot = await getDocsFromServer(query(collection(db, 'recipes'), orderBy('created_at', 'desc')));
        data = snapshot.docs.map(recipeFromSnap);
      } catch {
        if (requestId !== recipeListRequestId) return;
        const message = 'Could not load recipes right now. Please try again in a moment.';
        pendingListStatus.textContent = message;
        recipeListStatus.textContent = message;
        return;
      }

      if (requestId !== recipeListRequestId) return;

      const pending = data.filter((recipe) => recipe.status === 'pending');
      const others = data.filter((recipe) => recipe.status !== 'pending');

      // A count on the Pending tab, so submissions waiting for review get
      // noticed without opening that tab.
      pendingCount.textContent = pending.length ? ` (${pending.length})` : '';
      pendingCount.hidden = pending.length === 0;

      if (pending.length === 0) {
        pendingListStatus.textContent = 'No pending submissions.';
      } else {
        for (const recipe of pending) pendingList.append(buildPendingRow(recipe));
        pendingListStatus.hidden = true;
        pendingList.hidden = false;
      }

      if (others.length === 0) {
        recipeListStatus.textContent = 'No recipes yet.';
      } else {
        for (const recipe of others) recipeList.append(buildRecipeRow(recipe));
        recipeListStatus.hidden = true;
        recipeList.hidden = false;
      }
    }

    function buildThumb(recipe) {
      if (!recipe.photo_path) return null;
      const thumb = document.createElement('div');
      thumb.className = 'recipe-row-thumb';
      const img = document.createElement('img');
      setPhotoSrc(img, recipe.photo_path);
      img.alt = '';
      thumb.append(img);
      return thumb;
    }

    function buildRecipeRow(recipe) {
      const li = document.createElement('li');
      li.className = 'recipe-row';
      li.dataset.id = recipe.slug;

      const thumb = buildThumb(recipe);
      if (thumb) li.append(thumb);

      const info = document.createElement('div');
      info.className = 'recipe-row-info';
      const title = document.createElement('div');
      title.className = 'recipe-row-title';
      title.textContent = recipe.title;
      const meta = document.createElement('div');
      meta.className = 'recipe-row-meta';
      const badge = document.createElement('span');
      badge.className = 'category-badge';
      badge.textContent = recipe.category;
      meta.append(badge);
      if (recipe.status === 'deactivated') {
        const flag = document.createElement('span');
        flag.className = 'status-flag';
        flag.textContent = 'Deactivated';
        meta.append(flag);
      }
      const date = document.createElement('span');
      date.textContent = new Date(recipe.created_at).toLocaleDateString(undefined, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
      meta.append(date);
      info.append(title, meta);

      const actions = document.createElement('div');
      actions.className = 'recipe-row-actions';
      const editButton = document.createElement('button');
      editButton.type = 'button';
      editButton.className = 'secondary';
      editButton.textContent = 'Edit';
      editButton.addEventListener('click', () => startEditing(recipe));
      const toggleButton = document.createElement('button');
      toggleButton.type = 'button';
      toggleButton.className = 'secondary';
      toggleButton.textContent = recipe.status === 'deactivated' ? 'Reactivate' : 'Deactivate';
      toggleButton.addEventListener('click', () => toggleRecipeStatus(recipe));
      const deleteButton = document.createElement('button');
      deleteButton.type = 'button';
      deleteButton.className = 'secondary';
      deleteButton.textContent = 'Delete';
      deleteButton.addEventListener('click', () => deleteRecipe(recipe));
      actions.append(editButton, toggleButton, deleteButton);

      li.append(info, actions);
      return li;
    }

    function buildPendingRow(recipe) {
      const li = document.createElement('li');
      li.className = 'recipe-row';
      li.dataset.id = recipe.slug;

      const thumb = buildThumb(recipe);
      if (thumb) li.append(thumb);

      const info = document.createElement('div');
      info.className = 'recipe-row-info';
      const title = document.createElement('div');
      title.className = 'recipe-row-title';
      title.textContent = recipe.title;
      const meta = document.createElement('div');
      meta.className = 'recipe-row-meta';
      const badge = document.createElement('span');
      badge.className = 'category-badge';
      badge.textContent = recipe.category;
      const submittedBy = document.createElement('span');
      submittedBy.textContent = recipe.submitted_by ? `From ${recipe.submitted_by}` : 'Submitted anonymously';
      meta.append(badge, submittedBy);
      info.append(title, meta);

      const actions = document.createElement('div');
      actions.className = 'recipe-row-actions';
      const previewLink = document.createElement('a');
      previewLink.className = 'secondary button-link';
      previewLink.textContent = 'Preview';
      previewLink.href = `/recipes/view?slug=${encodeURIComponent(recipe.slug)}`;
      previewLink.target = '_blank';
      previewLink.rel = 'noopener noreferrer';
      const approveButton = document.createElement('button');
      approveButton.type = 'button';
      approveButton.textContent = 'Approve';
      approveButton.addEventListener('click', () => approveRecipe(recipe));
      const rejectButton = document.createElement('button');
      rejectButton.type = 'button';
      rejectButton.className = 'secondary';
      rejectButton.textContent = 'Reject';
      rejectButton.addEventListener('click', () => rejectRecipe(recipe));
      actions.append(previewLink, approveButton, rejectButton);

      li.append(info, actions);
      return li;
    }

    function startEditing(recipe) {
      editingSlug = recipe.slug;
      editingPhotoPath = recipe.photo_path;
      editingCreatedAt = recipe.created_at;

      populateRecipeForm(recipeForm, stagesList, recipe);
      // Loaded a real recipe's actual stages — lock them so a category change
      // while editing can't auto-replace them with that category's suggestions.
      markStagesTouched();
      photoInput.value = '';

      formHeading.textContent = 'Edit Recipe';
      recipeFormTab.textContent = 'Edit Recipe';
      saveButton.textContent = 'Update Recipe';
      cancelEditButton.hidden = false;
      recipeStatus.hidden = true;
      showView('subtab-form');
      recipeForm.scrollIntoView({ behavior: 'smooth' });
    }

    function stopEditing() {
      editingSlug = null;
      editingPhotoPath = null;
      editingCreatedAt = null;
      recipeForm.reset();
      // Unlocks and re-populates suggestions for whatever category the reset
      // form now shows (recipeForm.reset() puts it back to the default with no
      // "change" event, same gap as the initial page load).
      resetStageSuggestions();
      formHeading.textContent = 'Add a Recipe';
      recipeFormTab.textContent = 'Add a Recipe';
      saveButton.textContent = 'Save Recipe';
      cancelEditButton.hidden = true;
    }

    // Cancel goes back to the list the Edit came from; a successful save stays
    // on the form, where its "Saved — View the recipe" message is.
    cancelEditButton.addEventListener('click', () => {
      stopEditing();
      showView('subtab-stored');
    });

    wirePhotoInput(photoInput, photoError);

    previewButton.addEventListener('click', () => {
      const opened = openRecipePreview({
        form: recipeForm,
        stagesList,
        photoInput,
        existingPhotoPath: editingPhotoPath,
        createdAt: editingCreatedAt,
      });
      if (!opened) {
        recipeStatus.className = 'status error';
        recipeStatus.textContent = "Preview isn't available in this browser (it may be blocking site storage).";
        recipeStatus.hidden = false;
      }
    });

    // Shared by Delete (an existing published/deactivated recipe) and Reject (a
    // pending submission) — both are "remove this recipe and its photo for good."
    // Best-effort on the photo: an orphaned Storage object is a much smaller
    // problem than a delete that silently fails, so a storage error here doesn't
    // stop the document itself from being removed.
    async function removeRecipe(recipe, confirmMessage, failureMessage) {
      if (!confirm(confirmMessage)) return false;

      if (recipe.photo_path) {
        await deleteObject(ref(storage, `${RECIPE_PHOTOS_PATH}/${recipe.photo_path}`)).catch(() => {});
      }

      try {
        await deleteDoc(doc(db, 'recipes', recipe.slug));
      } catch {
        alert(failureMessage);
        return false;
      }
      return true;
    }

    async function deleteRecipe(recipe) {
      const removed = await removeRecipe(
        recipe,
        `Delete "${recipe.title}"? This can't be undone.`,
        'Could not delete this recipe — please try again.',
      );
      if (!removed) return;
      if (editingSlug === recipe.slug) stopEditing();
      loadRecipeList();
    }

    async function rejectRecipe(recipe) {
      const removed = await removeRecipe(
        recipe,
        `Reject "${recipe.title}"? This permanently deletes the submission and can't be undone.`,
        'Could not reject this submission — please try again.',
      );
      if (!removed) return;
      loadRecipeList();
    }

    async function setRecipeStatus(recipe, status) {
      try {
        await updateDoc(doc(db, 'recipes', recipe.slug), { status });
        return true;
      } catch {
        return false;
      }
    }

    async function approveRecipe(recipe) {
      if (!(await setRecipeStatus(recipe, 'published'))) {
        alert('Could not approve this recipe — please try again.');
        return;
      }
      loadRecipeList();
    }

    async function toggleRecipeStatus(recipe) {
      const newStatus = recipe.status === 'deactivated' ? 'published' : 'deactivated';
      if (!(await setRecipeStatus(recipe, newStatus))) {
        alert('Could not update this recipe — please try again.');
        return;
      }
      loadRecipeList();
    }

    // --- Members (Requirement #16) ---

    async function loadMembers() {
      membersStatus.hidden = false;
      membersStatus.textContent = 'Loading members…';
      membersList.hidden = true;
      membersList.innerHTML = '';

      // A member with an email is stored under that (lowercased) email — it's what
      // firestore.rules looks up to decide whether a signed-in email may submit.
      // One without (say, a sign-up sheet with just a phone) gets a generated
      // ID instead; see memberIdFor.
      let data;
      try {
        const snapshot = await getDocsFromServer(query(collection(db, 'active_members'), orderBy('created_at', 'desc')));
        data = snapshot.docs.map((snap) => ({
          ...snap.data(),
          id: snap.id,
          email: isEmailId(snap.id) ? snap.id : null,
          created_at: snap.data().created_at?.toDate?.() ?? new Date(),
        }));
      } catch {
        membersStatus.textContent = 'Could not load members right now. Please try again in a moment.';
        return;
      }

      if (data.length === 0) {
        membersStatus.textContent = 'No members yet.';
        return;
      }

      for (const member of data) membersList.append(buildMemberRow(member));
      membersStatus.hidden = true;
      membersList.hidden = false;
    }

    function buildMemberRow(member) {
      const li = document.createElement('li');
      li.className = 'recipe-row';
      li.dataset.id = member.id;

      const info = document.createElement('div');
      info.className = 'recipe-row-info';
      const title = document.createElement('div');
      title.className = 'recipe-row-title';
      // Members added before names were collected only have an email.
      title.textContent = member.name || member.email;
      const contact = document.createElement('div');
      contact.className = 'member-contact';
      contact.textContent = [member.name ? member.email : null, formatPhone(member.phone)].filter(Boolean).join(' · ');
      const meta = document.createElement('div');
      meta.className = 'recipe-row-meta';
      const badge = document.createElement('span');
      badge.className = member.active ? 'category-badge' : 'status-flag';
      badge.textContent = member.active ? 'Active' : 'Deactivated';
      const date = document.createElement('span');
      date.textContent = new Date(member.created_at).toLocaleDateString(undefined, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
      meta.append(badge);
      if (!member.email) {
        // Without an email there's nothing to log in with.
        const noEmail = document.createElement('span');
        noEmail.className = 'status-flag';
        noEmail.textContent = 'No email';
        noEmail.title = "Can't log in or submit recipes until an email is added";
        meta.append(noEmail);
      }
      meta.append(date);
      info.append(title);
      if (contact.textContent) info.append(contact);
      info.append(meta);

      const actions = document.createElement('div');
      actions.className = 'recipe-row-actions';
      const editButton = document.createElement('button');
      editButton.type = 'button';
      editButton.className = 'secondary';
      editButton.textContent = 'Edit';
      editButton.addEventListener('click', () => startEditingMember(member));
      const toggleButton = document.createElement('button');
      toggleButton.type = 'button';
      toggleButton.className = 'secondary';
      toggleButton.textContent = member.active ? 'Deactivate' : 'Reactivate';
      toggleButton.addEventListener('click', () => toggleMemberActive(member));
      actions.append(editButton, toggleButton);

      li.append(info, actions);
      return li;
    }

    async function toggleMemberActive(member) {
      try {
        await updateDoc(doc(db, 'active_members', member.id), { active: !member.active });
      } catch {
        alert('Could not update this member — please try again.');
        return;
      }
      loadMembers();
    }

    // null when adding; while editing, the member loaded into the form (see
    // startEditingMember). The same form does both, like the recipe form.
    let editingMember = null;

    function startEditingMember(member) {
      editingMember = member;
      addMemberForm.elements.name.value = member.name || '';
      addMemberForm.elements.email.value = member.email || '';
      addMemberForm.elements.phone.value = formatPhone(member.phone);
      memberFormHeading.textContent = 'Edit Member';
      memberFormTab.textContent = 'Edit Member';
      memberSaveButton.textContent = 'Save Changes';
      memberCancelButton.hidden = false;
      addMemberStatus.hidden = true;
      showView('subtab-member-form');
      addMemberForm.scrollIntoView({ behavior: 'smooth' });
    }

    function stopEditingMember() {
      editingMember = null;
      addMemberForm.reset();
      memberFormHeading.textContent = 'Add a Member';
      memberFormTab.textContent = 'Add a Member';
      memberSaveButton.textContent = 'Add Member';
      memberCancelButton.hidden = true;
    }

    // Same as the recipe form: Cancel returns to the list, a save stays here
    // to show its message.
    memberCancelButton.addEventListener('click', () => {
      stopEditingMember();
      showView('subtab-member-list');
    });

    // Tidy a valid phone into (402) 555-0134 as soon as the admin leaves the
    // field, so what they see matches how it will be shown. An invalid one is
    // left as typed; saving explains what's wrong with it.
    addMemberForm.elements.phone.addEventListener('blur', (event) => {
      if (phoneDigits(event.target.value)) event.target.value = formatPhone(event.target.value);
    });

    function alreadyAMember() {
      return Object.assign(new Error('Already a member'), { code: 'already-exists' });
    }

    // Real emails always contain "@" and generated IDs never do, so the two can't
    // collide — and since sign-in only ever looks up a signed-in email, a member
    // stored under a generated ID can't log in until an email is added.
    function isEmailId(id) {
      return id.includes('@');
    }

    // The document ID a member is stored under: their email when they have one,
    // otherwise a generated ID (kept as-is if the member already has one).
    function memberIdFor(email, existingId = null) {
      if (email) return email;
      if (existingId && !isEmailId(existingId)) return existingId;
      return `no-email-${crypto.randomUUID()}`;
    }

    async function addMember({ name, email, phone }) {
      const memberRef = doc(db, 'active_members', memberIdFor(email));
      if (email && (await getDoc(memberRef)).exists()) throw alreadyAMember();
      await setDoc(memberRef, { name, phone, active: true, created_at: serverTimestamp() });
    }

    // Adding, changing, or removing a member's email changes which ID they're
    // stored under, so it moves the record: recreate it under the new ID
    // (keeping active and created_at) and delete the old one. One transaction,
    // so a clash with an existing member's email changes nothing.
    async function saveMemberEdits(member, { name, email, phone }) {
      const oldRef = doc(db, 'active_members', member.id);
      const newId = memberIdFor(email, member.id);
      if (newId === member.id) {
        await updateDoc(oldRef, { name, phone });
        return;
      }
      const newRef = doc(db, 'active_members', newId);
      await runTransaction(db, async (tx) => {
        const oldSnap = await tx.get(oldRef);
        if ((await tx.get(newRef)).exists()) throw alreadyAMember();
        tx.set(newRef, { ...oldSnap.data(), name, phone });
        tx.delete(oldRef);
      });
    }

    addMemberForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      addMemberStatus.hidden = true;

      const formData = new FormData(addMemberForm);
      const phone = phoneDigits(formData.get('phone'));
      if (phone === null) {
        addMemberStatus.className = 'status error';
        addMemberStatus.textContent = 'The phone number needs 10 digits, for example (402) 555-0134.';
        addMemberStatus.hidden = false;
        addMemberForm.elements.phone.focus();
        return;
      }
      // Stored as bare digits (or null when left blank); formatPhone handles display.
      const fields = {
        name: String(formData.get('name') || '').trim(),
        email: String(formData.get('email') || '').trim().toLowerCase(),
        phone: phone || null,
      };
      if (!fields.email && !fields.phone) {
        addMemberStatus.className = 'status error';
        addMemberStatus.textContent = 'Add an email or a phone number, so the member can be reached.';
        addMemberStatus.hidden = false;
        addMemberForm.elements.email.focus();
        return;
      }
      const isEditing = editingMember !== null;
      memberSaveButton.disabled = true;

      try {
        if (isEditing) {
          await saveMemberEdits(editingMember, fields);
        } else {
          await addMember(fields);
        }

        const contact = fields.email || formatPhone(fields.phone);
        addMemberStatus.className = 'status success';
        addMemberStatus.textContent = isEditing
          ? `Saved changes to ${fields.name} (${contact}).`
          : `Added ${fields.name} (${contact}).`;
        addMemberStatus.hidden = false;
        stopEditingMember();
        loadMembers();
      } catch (err) {
        addMemberStatus.className = 'status error';
        if (err && err.code === 'already-exists') {
          addMemberStatus.textContent = isEditing
            ? 'Another member already has that email.'
            : 'That email is already a member.';
        } else {
          addMemberStatus.textContent = `Could not ${isEditing ? 'save this member' : 'add this member'} — please try again.`;
        }
        addMemberStatus.hidden = false;
      } finally {
        memberSaveButton.disabled = false;
      }
    });

    // --- Login/session ---

    function showLoggedIn(isLoggedIn) {
      loginSection.hidden = isLoggedIn;
      adminSection.hidden = !isLoggedIn;
      if (isLoggedIn) {
        loadRecipeList();
        loadMembers();
      }
    }

    // Reflect whatever the current session actually is (a returning admin stays
    // logged in via Firebase's persisted session; signing out elsewhere reflects
    // here). Only the admin account counts — a member signed in via /submit/ in the
    // same browser still sees the password form here, not an admin panel whose
    // every request firestore.rules would reject.
    onAuthStateChanged(auth, (user) => {
      showLoggedIn(user?.email === ADMIN_EMAIL);
    });

    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      loginError.hidden = true;

      const password = String(new FormData(loginForm).get('password') || '');
      try {
        await signInWithEmailAndPassword(auth, ADMIN_EMAIL, password);
      } catch {
        loginError.textContent = 'Incorrect password.';
        loginError.hidden = false;
        return;
      }

      loginForm.reset();
    });

    logoutButton.addEventListener('click', async () => {
      await signOut(auth);
    });

    recipeForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      recipeStatus.hidden = true;

      const fields = collectRecipeFields(recipeForm, stagesList);
      const photoFile = photoInput.files[0] || null;
      const isEditing = editingSlug !== null;

      saveButton.disabled = true;

      try {
        // The slug never changes on edit — it's the document ID, baked into
        // already-shared /recipes/view?slug=... links — so it's only computed
        // when creating (inside createRecipeWithUniqueSlug, which also handles
        // collisions).
        const baseSlug = isEditing ? editingSlug : slugify(fields.title) || 'recipe';

        // Upload happens before the Firestore write — if it fails, the form shows
        // an error and nothing is saved, rather than saving a broken photo
        // reference. If editing and no new file was chosen, the recipe's
        // existing photo_path is resubmitted unchanged.
        const photoPath = photoFile ? await uploadRecipePhoto(photoFile, baseSlug) : isEditing ? editingPhotoPath : null;
        const payload = { ...fields, photo_path: photoPath };

        // A new admin recipe is published immediately; editing an existing one
        // (published or deactivated) leaves whatever status it already has alone.
        let slug = editingSlug;
        if (isEditing) {
          await updateDoc(doc(db, 'recipes', editingSlug), payload);
        } else {
          slug = await createRecipeWithUniqueSlug(baseSlug, { ...payload, status: 'published' });
        }

        recipeStatus.className = 'status success';
        recipeStatus.innerHTML = `${isEditing ? 'Updated' : 'Saved'}. <a href="/recipes/view?slug=${encodeURIComponent(slug)}">View the recipe</a>.`;
        recipeStatus.hidden = false;
        stopEditing();
        loadRecipeList();
      } catch (err) {
        recipeStatus.className = 'status error';
        recipeStatus.textContent =
          'Could not save the recipe — please try again. If this keeps happening, the admin session may have expired; try logging out and back in.';
        recipeStatus.hidden = false;
      } finally {
        saveButton.disabled = false;
      }
    });
  </script>
</Layout>

<!--
  is:global: the time-stage rows, recipe/pending/member rows are all built
  client-side with document.createElement. Astro's scoped styles only match
  elements it renders itself, so a scoped style here would silently fail to
  apply to them.
-->
<style is:global>
  /* width: 100% because the page body is a flex column: without it, margin: auto
     shrinks the column to its content, so it narrowed on the Members tab. */
  .admin-page {
    width: 100%;
    max-width: 620px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .admin-page h1 {
    font-size: clamp(2rem, 4.5vw, 2.6rem);
    margin-bottom: 1.5rem;
  }

  .admin-page h2 {
    font-size: 1.5rem;
    margin: 1.5rem 0 1rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  label {
    font-weight: 600;
    color: var(--brown-deep);
    margin-top: 0.75rem;
  }

  .hint {
    font-weight: 400;
    color: var(--brown);
    opacity: 0.8;
  }

  input,
  select,
  textarea {
    font: inherit;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(44, 30, 18, 0.3);
    border-radius: 6px;
    background: var(--cream-light);
    color: var(--ink);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  textarea {
    resize: vertical;
    font-family: inherit;
  }

  button {
    font: inherit;
    font-weight: 600;
    margin-top: 1.25rem;
    padding: 0.65rem 1.2rem;
    border: none;
    border-radius: 8px;
    background: var(--green-deep);
    color: var(--cream-light);
    cursor: pointer;
    align-self: flex-start;
  }

  button:hover,
  button:focus-visible {
    background: var(--green);
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* 0.55 so the outline reaches 3:1 against both the page and the recipe
     rows' darker background; 0.3 measured 1.9:1. */
  button.secondary,
  .button-link.secondary {
    background: transparent;
    color: var(--brown-deep);
    border: 1px solid rgba(44, 30, 18, 0.55);
    margin-top: 0;
  }

  .button-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font: inherit;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    font-size: 0.9rem;
    border-radius: 8px;
  }

  .admin-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(44, 30, 18, 0.15);
  }

  .admin-bar p {
    margin: 0;
    color: var(--brown);
  }

  .admin-tabs {
    display: flex;
    gap: 0.35rem;
    margin-top: 1.5rem;
    border-bottom: 1px solid rgba(44, 30, 18, 0.2);
  }

  /* Overrides the page's filled green button style: tabs read as a strip. */
  .admin-tabs button[role='tab'] {
    margin: 0 0 -1px;
    padding: 0.8rem 1.6rem;
    background: transparent;
    color: var(--brown);
    border: none;
    border-bottom: 4px solid transparent;
    border-radius: 8px 8px 0 0;
    font-size: 1.35rem;
  }

  .admin-tabs button[role='tab']:hover {
    background: var(--cream);
    color: var(--brown-deep);
  }

  .admin-tabs button[role='tab'][aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--green-deep);
  }

  .admin-tabs button[role='tab']:focus-visible {
    background: var(--cream);
    outline: 2px solid var(--green-deep);
    outline-offset: -2px;
  }

  /* Second-level tabs inside Recipes: smaller pills, so the two levels read
     as different things. */
  .admin-subtabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 1.25rem;
  }

  .admin-subtabs button[role='tab'] {
    margin: 0;
    padding: 0.45rem 1rem;
    background: transparent;
    color: var(--brown-deep);
    border: 1px solid rgba(44, 30, 18, 0.55);
    border-radius: 999px;
    font-size: 1rem;
  }

  .admin-subtabs button[role='tab']:hover {
    background: var(--cream);
  }

  .admin-subtabs button[role='tab'][aria-selected='true'] {
    background: var(--green-deep);
    border-color: var(--green-deep);
    color: var(--cream-light);
  }

  .admin-subtabs button[role='tab']:focus-visible {
    outline: 2px solid var(--green-deep);
    outline-offset: 2px;
  }

  .field-note {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--brown);
  }

  .field-error {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--wine);
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .form-actions button {
    margin-top: 0;
  }

  .recipe-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* Wraps on narrow screens: the info column keeps at least ~12rem, and the
     action buttons drop to their own line beneath it instead of squeezing the
     title down to nothing and overlapping the text. */
  .recipe-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.85rem;
    padding: 0.6rem 0.85rem;
    background: var(--cream);
    border: 1px solid rgba(44, 30, 18, 0.15);
    border-radius: 8px;
  }

  .recipe-row-thumb {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 6px;
    overflow: hidden;
  }

  .recipe-row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recipe-row-info {
    flex: 1 1 12rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .recipe-row-title {
    font-weight: 600;
    color: var(--brown-deep);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .member-contact {
    font-size: 0.85rem;
    color: var(--brown);
    overflow-wrap: anywhere;
  }

  .recipe-row-meta {
    font-size: 0.82rem;
    color: var(--brown);
    opacity: 0.85;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .recipe-row .category-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--green-deep);
    color: var(--cream-light);
  }

  .status-flag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: rgba(44, 30, 18, 0.15);
    color: var(--brown-deep);
  }

  .recipe-row-actions {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: auto;
  }

  .recipe-row-actions button,
  .recipe-row-actions .button-link {
    margin-top: 0;
    padding: 0.4rem 0.8rem;
    font-size: 0.9rem;
  }

  #time-stages-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }

  .stage-row {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 0.5rem;
    align-items: center;
  }

  .stage-remove {
    padding: 0.4rem 0.7rem;
    line-height: 1;
    font-size: 1.1rem;
  }

  .stage-add {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .status {
    margin-top: 1rem;
  }

  .status.success {
    color: var(--green-deep);
    font-weight: 600;
  }

  .error {
    color: var(--wine);
    font-weight: 600;
  }
</style>
