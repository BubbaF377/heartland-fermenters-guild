---
import Layout from '../../layouts/Layout.astro';
import { RECIPE_CATEGORIES } from '../../lib/constants.js';
---

<Layout
  title="Admin — Heartland Fermenters Guild"
  description="Guild admin: manage recipes and members."
>
  <main class="admin-page">
    <h1>Admin</h1>

    <section id="login-section">
      <p>Enter the guild admin password to add a recipe.</p>
      <form id="login-form">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" />
        <button type="submit">Log in</button>
      </form>
      <p id="login-error" class="error" hidden></p>
    </section>

    <section id="admin-section" hidden>
      <div class="admin-bar">
        <p>Logged in.</p>
        <button id="logout-button" type="button" class="secondary">Log out</button>
      </div>

      <h2>Pending Recipes</h2>
      <p id="pending-list-status" class="status">Loading&hellip;</p>
      <ul id="pending-list" class="recipe-list" hidden></ul>

      <h2>Recipes</h2>
      <p id="recipe-list-status" class="status">Loading recipes&hellip;</p>
      <ul id="recipe-list" class="recipe-list" hidden></ul>

      <h2>Members</h2>
      <p id="members-status" class="status">Loading members&hellip;</p>
      <ul id="members-list" class="recipe-list" hidden></ul>
      <form id="add-member-form">
        <label for="member-email">Add a member</label>
        <input type="email" id="member-email" name="email" required placeholder="member@example.com" />
        <button type="submit">Add Member</button>
      </form>
      <p id="add-member-status" class="status" hidden></p>

      <h2 id="recipe-form-heading">Add a Recipe</h2>
      <form id="recipe-form">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required />

        <label for="category">Category</label>
        <select id="category" name="category" required>
          {RECIPE_CATEGORIES.map((category) => <option value={category}>{category}</option>)}
        </select>

        <label for="summary">Short summary</label>
        <textarea id="summary" name="summary" rows="2"></textarea>

        <label for="photo">Photo <span class="hint">(optional)</span></label>
        <input type="file" id="photo" name="photo" accept="image/*" />

        <label for="video_url">How-to video <span class="hint">(optional — a YouTube link)</span></label>
        <input type="url" id="video_url" name="video_url" placeholder="https://www.youtube.com/watch?v=..." />

        <label for="yield_text">Yield / servings <span class="hint">(optional)</span></label>
        <input type="text" id="yield_text" name="yield_text" placeholder="e.g. About 1 quart" />

        <label id="time-stages-label">Time stages <span class="hint">(optional — e.g. Prep, Ferment, Bake)</span></label>
        <div id="time-stages-list" aria-labelledby="time-stages-label"></div>
        <button type="button" id="add-stage-button" class="secondary stage-add">+ Add stage</button>

        <label for="ingredients">Ingredients <span class="hint">(one per line)</span></label>
        <textarea id="ingredients" name="ingredients" rows="6" required></textarea>

        <label for="instructions">Instructions <span class="hint">(one step per line)</span></label>
        <textarea id="instructions" name="instructions" rows="8" required></textarea>

        <label for="notes">Notes &amp; tips <span class="hint">(optional)</span></label>
        <textarea id="notes" name="notes" rows="3"></textarea>

        <label for="submitted_by">Your name <span class="hint">(optional)</span></label>
        <input type="text" id="submitted_by" name="submitted_by" />

        <div class="form-actions">
          <button type="submit" id="save-button">Save Recipe</button>
          <button type="button" id="cancel-edit-button" class="secondary" hidden>Cancel</button>
        </div>
      </form>
      <p id="recipe-status" class="status" hidden></p>
    </section>
  </main>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import { ADMIN_EMAIL, slugify, RECIPE_PHOTOS_BUCKET } from '../../lib/constants.js';
    import { wireStageEditor, collectRecipeFields, populateRecipeForm, uploadRecipePhoto } from '../../lib/recipe-form.js';

    const loginSection = document.getElementById('login-section');
    const adminSection = document.getElementById('admin-section');
    const loginForm = document.getElementById('login-form');
    const loginError = document.getElementById('login-error');
    const logoutButton = document.getElementById('logout-button');
    const recipeForm = document.getElementById('recipe-form');
    const recipeStatus = document.getElementById('recipe-status');
    const categorySelect = document.getElementById('category');
    const stagesList = document.getElementById('time-stages-list');
    const addStageButton = document.getElementById('add-stage-button');
    const photoInput = document.getElementById('photo');
    const pendingListStatus = document.getElementById('pending-list-status');
    const pendingList = document.getElementById('pending-list');
    const recipeListStatus = document.getElementById('recipe-list-status');
    const recipeList = document.getElementById('recipe-list');
    const membersStatus = document.getElementById('members-status');
    const membersList = document.getElementById('members-list');
    const addMemberForm = document.getElementById('add-member-form');
    const addMemberStatus = document.getElementById('add-member-status');
    const formHeading = document.getElementById('recipe-form-heading');
    const saveButton = document.getElementById('save-button');
    const cancelEditButton = document.getElementById('cancel-edit-button');

    // null in create mode; while editing, these hold the recipe's id and its
    // current slug/photo_path (the slug never changes on edit — see startEditing
    // — and the photo_path is resubmitted unchanged unless a new file is chosen).
    let editingId = null;
    let editingSlug = null;
    let editingPhotoPath = null;

    const { markTouched: markStagesTouched, reset: resetStageSuggestions } = wireStageEditor({
      stagesList,
      addStageButton,
      categorySelect,
    });

    // --- Recipe + pending-recipe lists (Requirements #14, #16) ---

    // Supabase fires onAuthStateChange multiple times for a single page load with
    // a persisted session (INITIAL_SESSION, then SIGNED_IN), and showLoggedIn also
    // runs once more from the explicit getSession() check below — so this can be
    // called several times in close succession. Each call clears the lists before
    // its await, so without a guard, overlapping calls each clear then later append
    // their own copy, rendering the same rows multiple times. This id makes only
    // the most recently started call allowed to render; a call superseded by a
    // newer one discards its results instead of appending stale duplicates.
    let recipeListRequestId = 0;

    // One fetch (the admin-read-all RLS policy covers every status) split
    // client-side into the pending queue and the published/deactivated list,
    // rather than two round-trips.
    async function loadRecipeList() {
      const requestId = ++recipeListRequestId;

      pendingListStatus.hidden = false;
      pendingListStatus.textContent = 'Loading…';
      pendingList.hidden = true;
      pendingList.innerHTML = '';

      recipeListStatus.hidden = false;
      recipeListStatus.textContent = 'Loading recipes…';
      recipeList.hidden = true;
      recipeList.innerHTML = '';

      const { data, error } = await supabase
        .from('recipes')
        .select('*')
        .order('created_at', { ascending: false });

      if (requestId !== recipeListRequestId) return;

      if (error) {
        const message = 'Could not load recipes right now. Please try again in a moment.';
        pendingListStatus.textContent = message;
        recipeListStatus.textContent = message;
        return;
      }

      const pending = (data || []).filter((recipe) => recipe.status === 'pending');
      const others = (data || []).filter((recipe) => recipe.status !== 'pending');

      if (pending.length === 0) {
        pendingListStatus.textContent = 'No pending submissions.';
      } else {
        for (const recipe of pending) pendingList.append(buildPendingRow(recipe));
        pendingListStatus.hidden = true;
        pendingList.hidden = false;
      }

      if (others.length === 0) {
        recipeListStatus.textContent = 'No recipes yet.';
      } else {
        for (const recipe of others) recipeList.append(buildRecipeRow(recipe));
        recipeListStatus.hidden = true;
        recipeList.hidden = false;
      }
    }

    function recipePhotoUrl(recipe) {
      if (!recipe.photo_path) return null;
      const { data } = supabase.storage.from(RECIPE_PHOTOS_BUCKET).getPublicUrl(recipe.photo_path);
      return data.publicUrl;
    }

    function buildThumb(recipe) {
      const photoUrl = recipePhotoUrl(recipe);
      if (!photoUrl) return null;
      const thumb = document.createElement('div');
      thumb.className = 'recipe-row-thumb';
      const img = document.createElement('img');
      img.src = photoUrl;
      img.alt = '';
      thumb.append(img);
      return thumb;
    }

    function buildRecipeRow(recipe) {
      const li = document.createElement('li');
      li.className = 'recipe-row';
      li.dataset.id = recipe.id;

      const thumb = buildThumb(recipe);
      if (thumb) li.append(thumb);

      const info = document.createElement('div');
      info.className = 'recipe-row-info';
      const title = document.createElement('div');
      title.className = 'recipe-row-title';
      title.textContent = recipe.title;
      const meta = document.createElement('div');
      meta.className = 'recipe-row-meta';
      const badge = document.createElement('span');
      badge.className = 'category-badge';
      badge.textContent = recipe.category;
      meta.append(badge);
      if (recipe.status === 'deactivated') {
        const flag = document.createElement('span');
        flag.className = 'status-flag';
        flag.textContent = 'Deactivated';
        meta.append(flag);
      }
      const date = document.createElement('span');
      date.textContent = new Date(recipe.created_at).toLocaleDateString(undefined, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
      meta.append(date);
      info.append(title, meta);

      const actions = document.createElement('div');
      actions.className = 'recipe-row-actions';
      const editButton = document.createElement('button');
      editButton.type = 'button';
      editButton.className = 'secondary';
      editButton.textContent = 'Edit';
      editButton.addEventListener('click', () => startEditing(recipe));
      const toggleButton = document.createElement('button');
      toggleButton.type = 'button';
      toggleButton.className = 'secondary';
      toggleButton.textContent = recipe.status === 'deactivated' ? 'Reactivate' : 'Deactivate';
      toggleButton.addEventListener('click', () => toggleRecipeStatus(recipe));
      const deleteButton = document.createElement('button');
      deleteButton.type = 'button';
      deleteButton.className = 'secondary';
      deleteButton.textContent = 'Delete';
      deleteButton.addEventListener('click', () => deleteRecipe(recipe));
      actions.append(editButton, toggleButton, deleteButton);

      li.append(info, actions);
      return li;
    }

    function buildPendingRow(recipe) {
      const li = document.createElement('li');
      li.className = 'recipe-row';
      li.dataset.id = recipe.id;

      const thumb = buildThumb(recipe);
      if (thumb) li.append(thumb);

      const info = document.createElement('div');
      info.className = 'recipe-row-info';
      const title = document.createElement('div');
      title.className = 'recipe-row-title';
      title.textContent = recipe.title;
      const meta = document.createElement('div');
      meta.className = 'recipe-row-meta';
      const badge = document.createElement('span');
      badge.className = 'category-badge';
      badge.textContent = recipe.category;
      const submittedBy = document.createElement('span');
      submittedBy.textContent = recipe.submitted_by ? `From ${recipe.submitted_by}` : 'Submitted anonymously';
      meta.append(badge, submittedBy);
      info.append(title, meta);

      const actions = document.createElement('div');
      actions.className = 'recipe-row-actions';
      const previewLink = document.createElement('a');
      previewLink.className = 'secondary button-link';
      previewLink.textContent = 'Preview';
      previewLink.href = `/recipes/view?slug=${encodeURIComponent(recipe.slug)}`;
      previewLink.target = '_blank';
      previewLink.rel = 'noopener noreferrer';
      const approveButton = document.createElement('button');
      approveButton.type = 'button';
      approveButton.textContent = 'Approve';
      approveButton.addEventListener('click', () => approveRecipe(recipe));
      const rejectButton = document.createElement('button');
      rejectButton.type = 'button';
      rejectButton.className = 'secondary';
      rejectButton.textContent = 'Reject';
      rejectButton.addEventListener('click', () => rejectRecipe(recipe));
      actions.append(previewLink, approveButton, rejectButton);

      li.append(info, actions);
      return li;
    }

    function startEditing(recipe) {
      editingId = recipe.id;
      editingSlug = recipe.slug;
      editingPhotoPath = recipe.photo_path;

      populateRecipeForm(recipeForm, stagesList, recipe);
      // Loaded a real recipe's actual stages — lock them so a category change
      // while editing can't auto-replace them with that category's suggestions.
      markStagesTouched();
      photoInput.value = '';

      formHeading.textContent = 'Edit Recipe';
      saveButton.textContent = 'Update Recipe';
      cancelEditButton.hidden = false;
      recipeStatus.hidden = true;
      recipeForm.scrollIntoView({ behavior: 'smooth' });
    }

    function stopEditing() {
      editingId = null;
      editingSlug = null;
      editingPhotoPath = null;
      recipeForm.reset();
      // Unlocks and re-populates suggestions for whatever category the reset
      // form now shows (recipeForm.reset() puts it back to the default with no
      // "change" event, same gap as the initial page load).
      resetStageSuggestions();
      formHeading.textContent = 'Add a Recipe';
      saveButton.textContent = 'Save Recipe';
      cancelEditButton.hidden = true;
    }

    cancelEditButton.addEventListener('click', stopEditing);

    // Shared by Delete (an existing published/deactivated recipe) and Reject (a
    // pending submission) — both are "remove this row and its photo for good."
    // Best-effort on the photo: an orphaned Storage object is a much smaller
    // problem than a delete that silently fails, so a storage error here doesn't
    // stop the row itself from being removed.
    async function removeRecipeRow(recipe, confirmMessage, failureMessage) {
      if (!confirm(confirmMessage)) return false;

      if (recipe.photo_path) {
        await supabase.storage.from(RECIPE_PHOTOS_BUCKET).remove([recipe.photo_path]);
      }

      const { error } = await supabase.from('recipes').delete().eq('id', recipe.id);
      if (error) {
        alert(failureMessage);
        return false;
      }
      return true;
    }

    async function deleteRecipe(recipe) {
      const removed = await removeRecipeRow(
        recipe,
        `Delete "${recipe.title}"? This can't be undone.`,
        'Could not delete this recipe — please try again.',
      );
      if (!removed) return;
      if (editingId === recipe.id) stopEditing();
      loadRecipeList();
    }

    async function rejectRecipe(recipe) {
      const removed = await removeRecipeRow(
        recipe,
        `Reject "${recipe.title}"? This permanently deletes the submission and can't be undone.`,
        'Could not reject this submission — please try again.',
      );
      if (!removed) return;
      loadRecipeList();
    }

    async function approveRecipe(recipe) {
      const { error } = await supabase.from('recipes').update({ status: 'published' }).eq('id', recipe.id);
      if (error) {
        alert('Could not approve this recipe — please try again.');
        return;
      }
      loadRecipeList();
    }

    async function toggleRecipeStatus(recipe) {
      const newStatus = recipe.status === 'deactivated' ? 'published' : 'deactivated';
      const { error } = await supabase.from('recipes').update({ status: newStatus }).eq('id', recipe.id);
      if (error) {
        alert('Could not update this recipe — please try again.');
        return;
      }
      loadRecipeList();
    }

    // --- Members (Requirement #16) ---

    async function loadMembers() {
      membersStatus.hidden = false;
      membersStatus.textContent = 'Loading members…';
      membersList.hidden = true;
      membersList.innerHTML = '';

      const { data, error } = await supabase
        .from('active_members')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) {
        membersStatus.textContent = 'Could not load members right now. Please try again in a moment.';
        return;
      }

      if (!data || data.length === 0) {
        membersStatus.textContent = 'No members yet.';
        return;
      }

      for (const member of data) membersList.append(buildMemberRow(member));
      membersStatus.hidden = true;
      membersList.hidden = false;
    }

    function buildMemberRow(member) {
      const li = document.createElement('li');
      li.className = 'recipe-row';
      li.dataset.id = member.id;

      const info = document.createElement('div');
      info.className = 'recipe-row-info';
      const title = document.createElement('div');
      title.className = 'recipe-row-title';
      title.textContent = member.email;
      const meta = document.createElement('div');
      meta.className = 'recipe-row-meta';
      const badge = document.createElement('span');
      badge.className = member.active ? 'category-badge' : 'status-flag';
      badge.textContent = member.active ? 'Active' : 'Deactivated';
      const date = document.createElement('span');
      date.textContent = new Date(member.created_at).toLocaleDateString(undefined, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
      meta.append(badge, date);
      info.append(title, meta);

      const actions = document.createElement('div');
      actions.className = 'recipe-row-actions';
      const toggleButton = document.createElement('button');
      toggleButton.type = 'button';
      toggleButton.className = 'secondary';
      toggleButton.textContent = member.active ? 'Deactivate' : 'Reactivate';
      toggleButton.addEventListener('click', () => toggleMemberActive(member));
      actions.append(toggleButton);

      li.append(info, actions);
      return li;
    }

    async function toggleMemberActive(member) {
      const { error } = await supabase
        .from('active_members')
        .update({ active: !member.active })
        .eq('id', member.id);
      if (error) {
        alert('Could not update this member — please try again.');
        return;
      }
      loadMembers();
    }

    addMemberForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      addMemberStatus.hidden = true;

      const email = String(new FormData(addMemberForm).get('email') || '').trim().toLowerCase();
      const submitButton = addMemberForm.querySelector('button[type="submit"]');
      submitButton.disabled = true;

      try {
        const { error } = await supabase.from('active_members').insert({ email });
        if (error) throw error;

        addMemberStatus.className = 'status success';
        addMemberStatus.textContent = `Added ${email}.`;
        addMemberStatus.hidden = false;
        addMemberForm.reset();
        loadMembers();
      } catch (err) {
        addMemberStatus.className = 'status error';
        addMemberStatus.textContent =
          err && err.code === '23505' ? 'That email is already a member.' : 'Could not add this member — please try again.';
        addMemberStatus.hidden = false;
      } finally {
        submitButton.disabled = false;
      }
    });

    // --- Login/session ---

    function showLoggedIn(isLoggedIn) {
      loginSection.hidden = isLoggedIn;
      adminSection.hidden = !isLoggedIn;
      if (isLoggedIn) {
        loadRecipeList();
        loadMembers();
      }
    }

    // Reflect whatever the current session actually is (a returning admin stays
    // logged in via Supabase's persisted session; signing out elsewhere reflects here).
    supabase.auth.onAuthStateChange((_event, session) => {
      showLoggedIn(Boolean(session));
    });

    const {
      data: { session: initialSession },
    } = await supabase.auth.getSession();
    showLoggedIn(Boolean(initialSession));

    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      loginError.hidden = true;

      const password = new FormData(loginForm).get('password');
      const { error } = await supabase.auth.signInWithPassword({
        email: ADMIN_EMAIL,
        password,
      });

      if (error) {
        loginError.textContent = 'Incorrect password.';
        loginError.hidden = false;
        return;
      }

      loginForm.reset();
    });

    logoutButton.addEventListener('click', async () => {
      await supabase.auth.signOut();
    });

    // A title's slug might collide with an existing recipe; try title, title-2,
    // title-3, ... until a free one is found, rather than failing the whole submit.
    async function findAvailableSlug(baseSlug) {
      for (let attempt = 0; attempt < 25; attempt++) {
        const candidate = attempt === 0 ? baseSlug : `${baseSlug}-${attempt + 1}`;
        const { data, error } = await supabase
          .from('recipes')
          .select('slug')
          .eq('slug', candidate)
          .maybeSingle();

        if (error) throw error;
        if (!data) return candidate;
      }
      throw new Error('Could not find an available slug — too many recipes with a similar title.');
    }

    recipeForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      recipeStatus.hidden = true;

      const fields = collectRecipeFields(recipeForm, stagesList);
      const photoFile = photoInput.files[0] || null;
      const isEditing = editingId !== null;

      saveButton.disabled = true;

      try {
        // The slug never changes on edit — it's baked into already-shared
        // /recipes/view?slug=... links — so it's only (re)computed when creating.
        const slug = isEditing ? editingSlug : await findAvailableSlug(slugify(fields.title) || 'recipe');

        // Upload happens before the database write — if it fails, the form shows
        // an error and nothing is saved, rather than saving a broken photo
        // reference. If editing and no new file was chosen, the recipe's
        // existing photo_path is resubmitted unchanged.
        const photoPath = photoFile ? await uploadRecipePhoto(supabase, photoFile, slug) : isEditing ? editingPhotoPath : null;

        // Admin-created/edited recipes don't touch `status` here — a new recipe
        // gets the table's 'published' default, and editing an existing one
        // (published or deactivated) leaves whatever status it already has alone.
        const payload = { ...fields, slug, photo_path: photoPath };

        const { error } = isEditing
          ? await supabase.from('recipes').update(payload).eq('id', editingId)
          : await supabase.from('recipes').insert(payload);

        if (error) throw error;

        recipeStatus.className = 'status success';
        recipeStatus.innerHTML = `${isEditing ? 'Updated' : 'Saved'}. <a href="/recipes/view?slug=${encodeURIComponent(slug)}">View the recipe</a>.`;
        recipeStatus.hidden = false;
        stopEditing();
        loadRecipeList();
      } catch (err) {
        recipeStatus.className = 'status error';
        recipeStatus.textContent =
          'Could not save the recipe — please try again. If this keeps happening, the admin session may have expired; try logging out and back in.';
        recipeStatus.hidden = false;
      } finally {
        saveButton.disabled = false;
      }
    });
  </script>
</Layout>

<!--
  is:global: the time-stage rows, recipe/pending/member rows are all built
  client-side with document.createElement. Astro's scoped styles only match
  elements it renders itself, so a scoped style here would silently fail to
  apply to them.
-->
<style is:global>
  .admin-page {
    max-width: 620px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .admin-page h1 {
    font-size: clamp(2rem, 4.5vw, 2.6rem);
    margin-bottom: 1.5rem;
  }

  .admin-page h2 {
    font-size: 1.5rem;
    margin: 1.5rem 0 1rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  label {
    font-weight: 600;
    color: var(--brown-deep);
    margin-top: 0.75rem;
  }

  .hint {
    font-weight: 400;
    color: var(--brown);
    opacity: 0.8;
  }

  input,
  select,
  textarea {
    font: inherit;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(44, 30, 18, 0.3);
    border-radius: 6px;
    background: var(--cream-light);
    color: var(--ink);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  textarea {
    resize: vertical;
    font-family: inherit;
  }

  button {
    font: inherit;
    font-weight: 600;
    margin-top: 1.25rem;
    padding: 0.65rem 1.2rem;
    border: none;
    border-radius: 8px;
    background: var(--green-deep);
    color: var(--cream-light);
    cursor: pointer;
    align-self: flex-start;
  }

  button:hover,
  button:focus-visible {
    background: var(--green);
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  button.secondary,
  .button-link.secondary {
    background: transparent;
    color: var(--brown-deep);
    border: 1px solid rgba(44, 30, 18, 0.3);
    margin-top: 0;
  }

  .button-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font: inherit;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    font-size: 0.9rem;
    border-radius: 8px;
  }

  .admin-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
