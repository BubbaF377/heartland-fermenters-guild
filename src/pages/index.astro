---
import Layout from '../layouts/Layout.astro';

const links = [
  {
    label: 'Email the Guild',
    sub: 'makers@heartlandfermentersguild.org',
    href: 'mailto:makers@heartlandfermentersguild.org',
    icon: 'mail',
  },
  {
    label: 'Facebook Page',
    sub: 'Guild news & announcements',
    href: 'https://www.facebook.com/profile.php?id=61592875371148',
    icon: 'flag',
  },
  {
    label: 'Facebook Group',
    sub: 'Talk ferments with members',
    href: 'https://www.facebook.com/groups/1026656100158944/',
    icon: 'bubbles',
  },
  {
    label: 'Instagram',
    sub: '@heartlandfermentersguild',
    href: 'https://www.instagram.com/heartlandfermentersguild/',
    icon: 'camera',
  },
  {
    label: 'Meetup',
    sub: 'Find our next gathering',
    href: 'https://www.meetup.com/heartland-fermenters-guild/',
    icon: 'calendar',
  },
];

const icons: Record<string, string> = {
  mail: 'M3 6h18v12H3z M3 6l9 7 9-7',
  flag: 'M5 3v18 M5 4h13l-3 4 3 4H5',
  bubbles: 'M4 5h11v7H8l-3 3v-3H4z M13 9h7v6h-3v3l-3-3h-1z',
  camera: 'M4 8h3l2-2h6l2 2h3v11H4z M12 12.5a3 3 0 1 0 0.001 0z',
  calendar: 'M4 5h16v15H4z M4 9h16 M8 3v4 M16 3v4',
};
---

<Layout
  title="Heartland Fermenters Guild"
  description="A community of home brewers, bakers, picklers, and cheesemakers preserving culture in the Heartland — learn, share, and ferment together."
>
  <header class="hero">
    <picture>
      <source srcset="/assets/banner.webp" type="image/webp" />
      <img
        src="/assets/banner-1200.jpg"
        alt="Heartland Fermenters Guild — a barn, fermentation crocks, bread, wine and beer amid heartland farmland, with the guild crest and the motto Learn, Share, Preserve"
        width="1200"
        height="456"
        class="hero-image"
      />
    </picture>
  </header>

  <main>
    <h1>Heartland Fermenters Guild</h1>
    <p class="tagline">Preserving Culture Since 2026</p>

    <p class="welcome">
      The Heartland Fermenters Guild is a community of people who enjoy making and
      sharing fermented foods and beverages. Whether you&rsquo;re brewing beer, making
      wine, baking sourdough, fermenting vegetables, crafting kombucha, aging cheese,
      or simply curious about the process, you&rsquo;ll find a place here.
    </p>

    <section class="links" aria-label="Connect with the guild">
      <h2>Join the Conversation</h2>
      <ul class="link-list">
        {
          links.map((link) => (
            <li>
              <a class="link-card" href={link.href} target="_blank" rel="noopener noreferrer">
                <svg
                  class="link-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={icons[link.icon]} />
                </svg>
                <span class="link-text">
                  <span class="link-label">{link.label}</span>
                  <span class="link-sub">{link.sub}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer>
    <div class="footer-inner">
      <p>&copy; {new Date().getFullYear()} Heartland Fermenters Guild &middot; Made with care in the Heartland</p>
      <a href="https://www.starterculturestudio.com" target="_blank" rel="noopener noreferrer" class="starter-culture-link">
        <img
          src="/assets/starter-culture-logo.svg"
          alt="Starter Culture Studio"
          class="starter-culture-logo"
        />
      </a>
    </div>
  </footer>
</Layout>

<style>
  .hero {
    width: 100%;
    background: var(--cream);
    border-bottom: 4px solid var(--brown-deep);
  }

  .hero-image {
    width: 100%;
    height: auto;
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
    text-align: center;
  }

  h1 {
    margin-top: 2.5rem;
    font-size: clamp(2.2rem, 5vw, 3rem);
  }

  .tagline {
    margin: 0.35rem 0 2rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 1rem;
    color: var(--gold);
  }

  .welcome {
    max-width: 620px;
    margin: 0 auto 3rem;
    font-size: 1.2rem;
    color: var(--brown);
  }

  .links h2 {
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
  }

  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    text-align: left;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    background: var(--cream);
    border: 1px solid rgba(44, 30, 18, 0.15);
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .link-card:hover,
  .link-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(44, 30, 18, 0.18);
    border-color: var(--gold);
  }

  .link-icon {
    flex: none;
    width: 26px;
    height: 26px;
    color: var(--green-deep);
  }

  .link-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .link-label {
    font-weight: 600;
    color: var(--brown-deep);
  }

  .link-sub {
    font-size: 0.88rem;
    color: var(--brown);
    opacity: 0.85;
    word-break: break-word;
  }

  footer {
    padding: 1.5rem 1.5rem 2.5rem;
    color: var(--brown);
    font-size: 0.9rem;
    background: var(--cream);
    border-top: 1px solid rgba(44, 30, 18, 0.15);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  footer p {
    margin: 0;
    text-align: left;
  }

  .starter-culture-link {
    flex: none;
    line-height: 0;
  }

  .starter-culture-logo {
    height: 32px;
    width: auto;
    display: block;
  }
</style>
