---
import Layout from '../../layouts/Layout.astro';
import resources from '../../data/fermentation-resources.json';
import { AREA_GROUPS, MEDIA_TYPES, RESOURCE_TYPES, areaLabel } from '../../lib/resources.js';

// How many resources carry each tag, shown beside it so an unused tag (Natto,
// today) reads as "0" rather than as a broken filter.
const tagCounts = {};
for (const r of resources) {
  for (const tag of [...r.area, ...r.resourceType, ...r.mediaType]) {
    tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
  }
}
const count = (tag) => tagCounts[tag] ?? 0;
---

<Layout
  title="Resources — Heartland Fermenters Guild"
  description="A curated directory of fermentation-education resources — authors, organizations, videos, and references on everything from sourdough to sake."
>
  <main class="resources-page">
    <h1>Resources</h1>
    <p class="intro">
      A curated list of websites and YouTube channels the guild recommends for learning fermentation
      technique, history, and science. It deliberately leaves out recipe collections and social-media
      influencers &mdash; for recipes from guild members, see <a href="/recipes/">Recipes</a>.
    </p>
    <p class="intro intro-how">Ask a question in plain English, or search and filter the list yourself.</p>

    <form id="ask-form" class="ask-panel">
      <label for="ask-input" class="ask-label">Ask in plain English</label>
      <div class="ask-row">
        <div class="clearable">
          <input
            id="ask-input"
            type="text"
            maxlength="300"
            autocomplete="off"
            placeholder="e.g. What can I make with a lot of extra cabbage?"
            required
          />
          <button type="button" class="clear-input" aria-label="Clear question">&times;</button>
        </div>
        <button type="submit" id="ask-button">Ask</button>
      </div>
      <p id="ask-status" class="ask-status" role="status" aria-live="polite"></p>
    </form>

    <div class="resources-layout">
      <aside class="filter-rail" aria-label="Search and filters">
        <button type="button" id="filters-toggle" class="filters-toggle" aria-expanded="false" aria-controls="filter-body">
          Search &amp; filters <span id="filters-active-count" class="active-count"></span>
        </button>

        <div id="filter-body" class="filter-body">
          <div class="rail-section">
            <label for="keyword-input" class="rail-heading">Search the list</label>
            <div class="clearable">
              <input id="keyword-input" type="search" autocomplete="off" placeholder="Name or description" />
              <button type="button" class="clear-input" aria-label="Clear search">&times;</button>
            </div>
            <button type="button" id="clear-filters" class="text-button clear-filters">Clear search &amp; filters</button>
          </div>

          <fieldset class="rail-section">
            <legend class="rail-heading">Type</legend>
            <div class="pill-row">
              {
                RESOURCE_TYPES.map((type) => (
                  <label class="pill">
                    <input type="checkbox" name="type" value={type} />
                    {type}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="rail-section">
            <legend class="rail-heading">Media</legend>
            <div class="pill-row">
              {
                MEDIA_TYPES.map((media) => (
                  <label class="pill">
                    <input type="checkbox" name="media" value={media} />
                    {media}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="rail-section">
            <legend class="rail-heading">Area</legend>
            {
              AREA_GROUPS.map((group, i) => (
                <div class="area-group">
                  <button
                    type="button"
                    class="area-group-toggle"
                    aria-expanded="false"
                    aria-controls={`area-group-${i}`}
                  >
                    {group.label}
                    <span class="chevron" aria-hidden="true" />
                  </button>
                  <ul id={`area-group-${i}`} class="area-list" hidden>
                    <li class="select-all">
                      <label>
                        <input type="checkbox" class="area-group-check" data-group={i} />
                        <span>
                          Select all<span class="visually-hidden"> {group.label}</span>
                        </span>
                      </label>
                    </li>
                    {group.areas.map((area) => (
                      <li>
                        <label>
                          <input type="checkbox" name="area" value={area} data-group={i} />
                          <span>{areaLabel(area)}</span>
                          <span class="tag-count">{count(area)}</span>
                        </label>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </fieldset>
        </div>
      </aside>

      <section class="results" aria-label="Resources">
        <div id="ai-banner" class="ai-banner" hidden>
          <p>Best matches for <q id="ai-question"></q></p>
          <button type="button" id="ai-clear" class="text-button">Show all resources</button>
        </div>
        <p id="results-summary" class="results-summary" role="status" aria-live="polite">
          Showing all {resources.length} resources
        </p>

        <ul id="resource-list" class="resource-list">
          {
            resources.map((r, i) => (
              <li class="resource-card" data-index={i}>
                <h2>
                  <a href={r.website} target="_blank" rel="noopener noreferrer">
                    {r.name}
                  </a>
                </h2>
                <p class="resource-description">{r.description}</p>
                <ul class="tag-list" aria-label="Tags">
                  {r.mediaType.map((m) => (
                    <li class="tag tag-media">{m}</li>
                  ))}
                  {r.resourceType.map((t) => (
                    <li class="tag tag-type">{t}</li>
                  ))}
                  {r.area.map((a) => (
                    <li class="tag tag-area">{areaLabel(a)}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>

        <div id="empty-state" class="empty-state" hidden>
          <p>No resources match.</p>
          <button type="button" id="empty-clear" class="text-button">Clear search &amp; filters</button>
        </div>
      </section>
    </div>
  </main>

  <script>
    import resources from '../../data/fermentation-resources.json';
    import { filterResources, isRateLimitError } from '../../lib/resources.js';

    const byId = (id) => document.getElementById(id);
    const listEl = byId('resource-list');
    const cards = [...listEl.querySelectorAll('.resource-card')];
    const keywordInput = byId('keyword-input');
    const summaryEl = byId('results-summary');
    const emptyEl = byId('empty-state');
    const aiBanner = byId('ai-banner');
    const askForm = byId('ask-form');
    const askInput = byId('ask-input');
    const askButton = byId('ask-button');
    const askStatus = byId('ask-status');
    const checkboxes = (name) => [...document.querySelectorAll(`input[name="${name}"]`)];
    const selected = (name) => new Set(checkboxes(name).filter((c) => c.checked).map((c) => c.value));

    // Dataset positions of the current AI matches, best first — or null when
    // browsing the whole list.
    let aiIds = null;

    function render() {
      const base = aiIds ? aiIds.map((i) => ({ ...resources[i], index: i })) : resources.map((r, index) => ({ ...r, index }));
      const shown = filterResources(base, {
        text: keywordInput.value,
        areas: selected('area'),
        types: selected('type'),
        media: selected('media'),
      });

      // Re-appending in order puts AI matches in rank order; browsing restores the
      // dataset order the page was built with.
      const visible = new Set(shown.map((r) => r.index));
      const order = aiIds ? [...shown.map((r) => r.index), ...cards.map((_, i) => i).filter((i) => !visible.has(i))] : cards.map((_, i) => i);
      for (const i of order) {
        cards[i].hidden = !visible.has(i);
        listEl.append(cards[i]);
      }

      const total = aiIds ? aiIds.length : resources.length;
      const noun = aiIds ? 'matches' : 'resources';
      summaryEl.textContent =
        shown.length === total ? `Showing all ${total} ${noun}` : `Showing ${shown.length} of ${total} ${noun}`;
      emptyEl.hidden = shown.length > 0;

      const active = selected('area').size + selected('type').size + selected('media').size + (keywordInput.value.trim() ? 1 : 0);
      byId('filters-active-count').textContent = active ? `(${active})` : '';
      syncGroupChecks();
    }

    // A panel's Select all checkbox shows whether all, some, or none of its tags
    // are selected.
    function syncGroupChecks() {
      for (const groupCheck of document.querySelectorAll('.area-group-check')) {
        const boxes = checkboxes('area').filter((c) => c.dataset.group === groupCheck.dataset.group);
        const on = boxes.filter((c) => c.checked).length;
        groupCheck.checked = on === boxes.length;
        groupCheck.indeterminate = on > 0 && on < boxes.length;
      }
    }

    function clearFilters() {
      keywordInput.value = '';
      for (const c of document.querySelectorAll('.filter-rail input[type="checkbox"]')) c.checked = false;
      render();
    }

    function showAllResources() {
      aiIds = null;
      aiBanner.hidden = true;
      askStatus.textContent = '';
      render();
    }

    keywordInput.addEventListener('input', render);
    for (const c of document.querySelectorAll('input[name="area"], input[name="type"], input[name="media"]')) {
      c.addEventListener('change', render);
    }

    // Select all: select every tag in the panel, or clear them all if every one is
    // already selected.
    for (const groupCheck of document.querySelectorAll('.area-group-check')) {
      groupCheck.addEventListener('change', () => {
        const boxes = checkboxes('area').filter((c) => c.dataset.group === groupCheck.dataset.group);
        const allOn = boxes.every((c) => c.checked);
        for (const c of boxes) c.checked = !allOn;
        render();
      });
    }

    // Panels open and close independently — not an accordion.
    for (const toggle of document.querySelectorAll('.area-group-toggle')) {
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        byId(toggle.getAttribute('aria-controls')).hidden = open;
      });
    }

    // On narrow screens the rail collapses behind this button (CSS hides the button
    // on wide screens, where the rail is always open).
    const filtersToggle = byId('filters-toggle');
    filtersToggle.addEventListener('click', () => {
      const open = filtersToggle.getAttribute('aria-expanded') === 'true';
      filtersToggle.setAttribute('aria-expanded', String(!open));
    });

    // The × in each text box. It only shows while the box has text (see the CSS).
    for (const button of document.querySelectorAll('.clear-input')) {
      button.addEventListener('click', () => {
        const input = button.previousElementSibling;
        input.value = '';
        input.dispatchEvent(new Event('input'));
        input.focus();
      });
    }

    byId('clear-filters').addEventListener('click', clearFilters);
    byId('empty-clear').addEventListener('click', clearFilters);
    byId('ai-clear').addEventListener('click', showAllResources);

    const AI_FAILED =
      "Sorry — the plain-English search isn't working right now. Try searching the list or using the filters instead.";
    const AI_RATE_LIMITED =
      "You've asked several questions in a short time. Please wait a minute and try again — or search and filter the list in the meantime.";

    askForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const question = askInput.value.trim();
      if (!question) return;

      askButton.disabled = true;
      askStatus.textContent = 'Searching…';
      try {
        // Loaded on first use, so the AI SDK only downloads for people who ask.
        const { askForResources } = await import('../../lib/resource-ai.js');
        const ids = await askForResources(question, resources);
        if (ids.length === 0) {
          askStatus.textContent =
            'Nothing on the list matched that question. Try different words, or search and filter the list instead.';
          return;
        }
        aiIds = ids;
        byId('ai-question').textContent = question;
        aiBanner.hidden = false;
        askStatus.textContent = '';
        render();
      } catch (err) {
        askStatus.textContent = isRateLimitError(err) ? AI_RATE_LIMITED : AI_FAILED;
      } finally {
        askButton.disabled = false;
      }
    });

    render();
  </script>
</Layout>

<style>
  .resources-page {
    --page-width: 1180px;
    max-width: var(--page-width);
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 2.6rem);
  }

  .intro {
    max-width: 680px;
    color: var(--brown);
    margin: 0.75rem 0 0;
  }

  .intro-how {
    margin: 0.5rem 0 1.75rem;
  }

  input[type='text'],
  input[type='search'] {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid rgba(44, 30, 18, 0.3);
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
  }

  input[type='text']:focus-visible,
  input[type='search']:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  /* The × clear button inside a text box, shown only while it has text. */
  .clearable {
    position: relative;
  }

  .clearable input {
    padding-right: 2.4rem;
  }

  .clear-input {
    position: absolute;
    top: 50%;
    right: 0.35rem;
    transform: translateY(-50%);
    width: 1.8rem;
    height: 1.8rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: none;
    color: var(--brown);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .clear-input:hover,
  .clear-input:focus-visible {
    background: rgba(44, 30, 18, 0.08);
    color: var(--ink);
  }

  .clearable input:placeholder-shown + .clear-input {
    display: none;
  }

  /* Browsers' own clear button on search boxes would double up with ours. */
  input[type='search']::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Ask in plain English */
  .ask-panel {
    background: var(--cream);
    border: 1px solid rgba(44, 30, 18, 0.15);
    border-radius: 12px;
    padding: 1.25rem 1.25rem 0.75rem;
    margin-bottom: 2rem;
  }

  .ask-label {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--brown-deep);
    margin-bottom: 0.5rem;
  }

  .ask-row {
    display: flex;
    gap: 0.6rem;
  }

  .ask-row .clearable {
    flex: 1;
  }

  .ask-row input {
    font-size: 1.05rem;
    padding: 0.7rem 0.9rem;
  }

  #ask-button {
    font: inherit;
    font-weight: 600;
    padding: 0 1.4rem;
    border: none;
    border-radius: 8px;
    background: var(--green-deep);
    color: var(--cream-light);
    cursor: pointer;
  }

  #ask-button:hover:not(:disabled),
  #ask-button:focus-visible {
    background: var(--green);
  }

  #ask-button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .ask-status {
    min-height: 1.5em;
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    font-style: italic;
    color: var(--brown);
  }

  /* Two columns: filter rail + results */
  .resources-layout {
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .filter-rail {
    position: sticky;
    top: 1rem;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  .filters-toggle {
    display: none;
  }

  .rail-section {
    border: none;
    margin: 0 0 1.4rem;
    padding: 0;
    min-width: 0;
  }

  .rail-heading {
    display: block;
    padding: 0;
    margin-bottom: 0.5rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--brown-deep);
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pill {
    font-size: 0.85rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid rgba(44, 30, 18, 0.3);
    border-radius: 999px;
    background: var(--cream-light);
    cursor: pointer;
    user-select: none;
  }

  .pill input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .pill:has(input:checked) {
    background: var(--green-deep);
    border-color: var(--green-deep);
    color: var(--cream-light);
  }

  .pill:has(input:focus-visible) {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  .area-group {
    border-bottom: 1px solid rgba(44, 30, 18, 0.12);
  }

  /* Checkbox, chevron, and count line up with the first line of a label that
     wraps, not its middle. */
  .area-group-toggle {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    text-align: left;
    padding: 0.45rem 0;
    border: none;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .chevron {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.2rem;
    border-right: 2px solid var(--brown);
    border-bottom: 2px solid var(--brown);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }

  .area-group-toggle[aria-expanded='true'] .chevron {
    transform: rotate(-135deg);
  }

  .area-list {
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0 0 0 1.5rem;
    font-size: 0.95rem;
  }

  .area-list label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.1rem 0;
    cursor: pointer;
  }

  .select-all {
    font-style: italic;
  }

  .tag-count {
    flex: none;
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--brown);
    opacity: 0.75;
  }

  input[type='checkbox'] {
    accent-color: var(--green-deep);
  }

  .clear-filters {
    margin-top: 0.4rem;
  }

  .text-button {
    font: inherit;
    font-size: 0.95rem;
    padding: 0;
    border: none;
    background: none;
    color: var(--green-deep);
    text-decoration: underline;
    cursor: pointer;
  }

  /* Results */
  .ai-banner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    margin-bottom: 0.75rem;
    border-left: 4px solid var(--gold);
    background: var(--cream);
    border-radius: 0 8px 8px 0;
  }

  .ai-banner[hidden] {
    display: none;
  }

  .ai-banner p {
    margin: 0;
  }

  .results-summary {
    margin: 0 0 1rem;
    color: var(--brown);
    font-size: 0.95rem;
  }

  .resource-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .resource-card {
    background: var(--cream);
    border: 1px solid rgba(44, 30, 18, 0.15);
    border-radius: 10px;
    padding: 1.1rem 1.25rem;
  }

  .resource-card h2 {
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
  }

  .resource-card h2 a {
    text-decoration: none;
  }

  .resource-card h2 a:hover,
  .resource-card h2 a:focus-visible {
    text-decoration: underline;
  }

  .resource-description {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    color: var(--brown);
  }

  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(44, 30, 18, 0.2);
    color: var(--brown-deep);
  }

  .tag-media {
    background: var(--wine);
    border-color: var(--wine);
    color: var(--cream-light);
  }

  .tag-type {
    background: var(--green-deep);
    border-color: var(--green-deep);
    color: var(--cream-light);
  }

  .empty-state {
    padding: 2rem 1rem;
    text-align: center;
    color: var(--brown);
  }

  .empty-state p {
    margin: 0 0 0.5rem;
    font-style: italic;
  }

  /* Narrow screens: one column, rail collapsed behind a toggle */
  @media (max-width: 800px) {
    .resources-page {
      padding: 1.75rem 1rem 3rem;
    }

    .resources-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .filter-rail {
      position: static;
      max-height: none;
      overflow: visible;
      padding: 0;
    }

    .filters-toggle {
      display: block;
      width: 100%;
      font: inherit;
      font-weight: 600;
      text-align: left;
      padding: 0.6rem 0.9rem;
      border: 1px solid rgba(44, 30, 18, 0.3);
      border-radius: 8px;
      background: var(--cream);
      color: var(--brown-deep);
      cursor: pointer;
    }

    .filters-toggle[aria-expanded='false'] + .filter-body {
      display: none;
    }

    .filter-body {
      padding-top: 1rem;
    }

    .ask-row {
      flex-direction: column;
    }

    #ask-button {
      padding: 0.65rem;
    }
  }
</style>
