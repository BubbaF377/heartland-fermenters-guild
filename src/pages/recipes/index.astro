---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Recipes — Heartland Fermenters Guild"
  description="Recipes shared by members of the Heartland Fermenters Guild — beer, wine, sourdough, pickles, kombucha, cheese, and more."
>
  <main class="recipes-page">
    <h1>Recipes</h1>
    <p class="intro">
      Recipes shared by guild members. New here? An account isn&rsquo;t needed to browse —
      only to add one, from the <a href="/admin/">admin page</a>.
    </p>

    <p id="recipes-status" class="status">Loading recipes&hellip;</p>
    <ul id="recipes-grid" class="recipe-grid" hidden></ul>
  </main>

  <script type="module">
    import { supabase } from '../../lib/supabase.js';

    const statusEl = document.getElementById('recipes-status');
    const gridEl = document.getElementById('recipes-grid');

    function categoryClass(category) {
      return 'category-' + category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    }

    function renderRecipes(recipes) {
      gridEl.innerHTML = '';
      for (const recipe of recipes) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'recipe-card';
        a.href = `/recipes/view?slug=${encodeURIComponent(recipe.slug)}`;

        const badge = document.createElement('span');
        badge.className = `category-badge ${categoryClass(recipe.category)}`;
        badge.textContent = recipe.category;

        const title = document.createElement('h2');
        title.textContent = recipe.title;

        const summary = document.createElement('p');
        summary.className = 'recipe-card-summary';
        summary.textContent = recipe.summary || '';

        a.append(badge, title, summary);
        li.append(a);
        gridEl.append(li);
      }
      gridEl.hidden = false;
    }

    async function loadRecipes() {
      const { data, error } = await supabase
        .from('recipes')
        .select('slug, title, category, summary, created_at')
        .order('created_at', { ascending: false });

      if (error) {
        statusEl.textContent =
          'Could not load recipes right now. Please try again in a moment.';
        return;
      }

      if (!data || data.length === 0) {
        statusEl.textContent = 'No recipes yet — check back soon.';
        return;
      }

      statusEl.hidden = true;
      renderRecipes(data);
    }

    loadRecipes();
  </script>
</Layout>

<style>
  .recipes-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .recipes-page h1 {
    font-size: clamp(2rem, 4.5vw, 2.6rem);
  }

  .intro {
    max-width: 620px;
    color: var(--brown);
    margin: 0.75rem 0 2rem;
  }

  .status {
    color: var(--brown);
    font-style: italic;
  }

  .recipe-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .recipe-card {
    display: block;
    padding: 1.25rem;
    background: var(--cream);
    border: 1px solid rgba(44, 30, 18, 0.15);
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .recipe-card:hover,
  .recipe-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(44, 30, 18, 0.18);
    border-color: var(--gold);
  }

  .recipe-card h2 {
    font-size: 1.3rem;
    margin: 0.6rem 0 0.4rem;
  }

  .recipe-card-summary {
    margin: 0;
    font-size: 0.95rem;
    color: var(--brown);
  }

  .category-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--green-deep);
    color: var(--cream-light);
  }
</style>
