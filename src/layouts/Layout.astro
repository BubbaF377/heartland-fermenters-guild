---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / social preview -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/assets/icon-512.png', Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="site-nav">
      <a class="site-nav-brand" href="/">
        <img src="/assets/logo.png" alt="" width="28" height="28" />
        Heartland Fermenters Guild
      </a>
      <a class="site-nav-link" href="/recipes/">Recipes</a>
    </nav>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner">
        <p>
          &copy; {new Date().getFullYear()} Heartland Fermenters Guild &middot; Made with care in the Heartland
          &middot; <a href="/admin/">Admin</a>
        </p>
        <a
          href="https://www.starterculturestudio.com"
          target="_blank"
          rel="noopener noreferrer"
          class="starter-culture-link"
        >
          <img src="/assets/starter-culture-logo.svg" alt="Starter Culture Studio" class="starter-culture-logo" />
        </a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --cream: #f4e7c9;
    --cream-light: #faf3e2;
    --ink: #2c1e12;
    --brown: #4a3320;
    --brown-deep: #33230f;
    --green: #3f5c3a;
    --green-deep: #2c4028;
    --gold: #b3862f;
    --wine: #6f2a35;
    --max-width: 880px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--cream-light);
    color: var(--ink);
    font-family: 'EB Garamond', Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
    line-height: 1.65;
  }

  h1,
  h2,
  h3 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: var(--brown-deep);
    letter-spacing: 0.02em;
    margin: 0;
  }

  a {
    color: var(--green-deep);
  }

  img {
    max-width: 100%;
    display: block;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.5rem;
    background: var(--brown-deep);
  }

  .site-nav-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--cream-light);
    text-decoration: none;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }

  .site-nav-brand img {
    border-radius: 50%;
  }

  .site-nav-link {
    color: var(--cream);
    text-decoration: none;
    font-weight: 600;
    opacity: 0.9;
  }

  .site-nav-link:hover,
  .site-nav-link:focus-visible {
    opacity: 1;
    text-decoration: underline;
  }

  .site-footer {
    padding: 1.5rem 1.5rem 2.5rem;
    color: var(--brown);
    font-size: 0.9rem;
    background: var(--cream);
    border-top: 1px solid rgba(44, 30, 18, 0.15);
  }

  .site-footer a {
    color: var(--brown);
    text-decoration: underline;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .site-footer p {
    margin: 0;
    text-align: left;
  }

  .starter-culture-link {
    flex: none;
    line-height: 0;
  }

  .starter-culture-logo {
    height: 32px;
    width: auto;
    display: block;
  }
</style>
